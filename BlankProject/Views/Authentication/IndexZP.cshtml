@using Domain.Resources
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = Config.SiteNameFa + " | ورود با تشخیص چهره";
    var apiBaseUrl = (ViewBag.ApiBaseUrl as string) ?? string.Empty;
    var message = TempData["Message"] as string;
}

<div class="auth-panel">
    <div class="row" style="margin:0">
        <section class="col-md-5 auth-visual-side" aria-label="راهنمای تشخیص چهره">
            <div class="auth-visual-content">
                <div class="auth-eyebrow">ورود بدون کلمه عبور</div>
                <h1 class="auth-title">سریع، آسان و ایمن وارد شوید</h1>
                <p class="auth-subtitle">
                    برای تشخیص دقیق، روبه‌روی دستگاه بایستید و صورت خود را در میدان دید دوربین قرار دهید.
                </p>
                <ul class="auth-feature-list">
                    <li><i class="material-icons" aria-hidden="true">wb_sunny</i><span>نور محیط روی صورت شما مناسب باشد</span></li>
                    <li><i class="material-icons" aria-hidden="true">center_focus_strong</i><span>مستقیم به دوربین نگاه کنید</span></li>
                    <li><i class="material-icons" aria-hidden="true">hourglass_empty</i><span>تا پایان پردازش در جای خود بمانید</span></li>
                </ul>
            </div>
        </section>

        <section class="col-md-7 auth-form-side face-stage">
            <div class="auth-eyebrow">احراز هویت هوشمند</div>
            <h2 class="auth-title">تشخیص چهره</h2>
            <p class="auth-subtitle">سامانه به‌صورت خودکار پس از شناسایی، شما را وارد پنل می‌کند.</p>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="auth-alert" role="alert">
                    <i class="material-icons" aria-hidden="true">error_outline</i>
                    <span>@message</span>
                </div>
            }

            <div class="face-orbit" aria-hidden="true">
                <div class="face-icon">
                    <i class="material-icons">face</i>
                </div>
            </div>

            <div class="connection-box" role="status" aria-live="polite">
                <span class="connection-dot" aria-hidden="true"></span>
                <span id="connectionStatus">در حال آماده‌سازی اتصال...</span>
            </div>

            <div>
                <a asp-controller="Authentication" asp-action="Login" class="auth-alt-link">
                    <i class="material-icons" aria-hidden="true">keyboard</i>
                    ورود با نام کاربری و کلمه عبور
                </a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // آدرس Hub فقط از تنظیمات برنامه دریافت می‌شود.
        window.API_BASE_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBaseUrl));
    </script>
    <script src="~/assets/signalr/signalr2.js"></script>
    <script src="~/Areas/AuthSystem/js/kiosk.js" asp-append-version="true"></script>
}
