@using Domain.Resources
@inject BLL.Interface.IConstantManager Settings
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = Config.SiteNameFa + " | ورود با تشخیص چهره";
    var message = TempData["FaceLoginMessage"] as string;
    var apiBaseUrl = (ViewBag.ApiBaseUrl as string) ?? string.Empty;
    var kioskId = ViewBag.KioskId is int configuredKioskId ? configuredKioskId : 0;
    var kioskRegistryError = ViewBag.KioskRegistryError as string;
    var browserNotMapped = kioskRegistryError?.Contains("مرورگر هنوز", StringComparison.Ordinal) == true;
    var loginMessage = Settings.GetLoginPageMessage(true);
}

<div class="auth-panel">
    <div class="row" style="margin:0">
        <section class="col-md-5 auth-visual-side" aria-label="راهنمای تشخیص چهره">
            <div class="auth-visual-content">
                <div class="auth-eyebrow">ورود بیومتریک</div>
                <p class="auth-subtitle">
                    برای تشخیص دقیق، روبه‌روی دستگاه بایستید و صورت خود را در میدان دید دوربین قرار دهید.
                </p>
                <ul class="auth-feature-list">
                    <li><i class="material-icons" aria-hidden="true">wb_sunny</i><span>نور محیط روی صورت شما مناسب باشد</span></li>
                    <li><i class="material-icons" aria-hidden="true">center_focus_strong</i><span>مستقیم به دوربین نگاه کنید</span></li>
                    <li><i class="material-icons" aria-hidden="true">hourglass_empty</i><span>تا پایان پردازش در جای خود بمانید</span></li>
                </ul>
            </div>
        </section>

        <section class="col-md-7 auth-form-side face-stage">
            <div class="auth-eyebrow">احراز هویت هوشمند</div>
            <h2 class="auth-title">تشخیص چهره</h2>
            <p class="auth-subtitle">سامانه به‌صورت خودکار پس از شناسایی، شما را وارد پنل می‌کند.</p>
            @if (!string.IsNullOrWhiteSpace(loginMessage.Text))
            {
                <p class="auth-subtitle" style="white-space:pre-line;color:@loginMessage.Color;font-size:@(loginMessage.FontSize)px;font-weight:@(loginMessage.Bold ? "700" : "400")">@loginMessage.Text</p>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="face-feedback face-feedback--error" role="alert" aria-live="assertive">
                    <span class="face-feedback-icon"><i class="material-icons" aria-hidden="true">error_outline</i></span>
                    <span class="face-feedback-copy"><strong>ورود انجام نشد</strong><span>@message</span></span>
                </div>
            }

            <div class="face-orbit" aria-hidden="true">
                <div class="face-icon">
                    <i class="material-icons">face</i>
                </div>
            </div>

            <form id="face-finalize-form"
                  action="@Url.Action("FinalizeFaceLogin", "Authentication", new { area = "" })"
                  method="post" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="kioskId" />
                <input type="hidden" name="enrollId" />
            </form>

            <div class="connection-box @(string.IsNullOrWhiteSpace(kioskRegistryError) ? "" : "connection-box--blocked")" role="status" aria-live="polite">
                <span class="connection-dot" aria-hidden="true"></span>
                <span id="connectionStatus">@(string.IsNullOrWhiteSpace(kioskRegistryError) ? "در حال آماده‌سازی اتصال..." : "نیازمند تنظیم مدیر سامانه")</span>
            </div>
            <div id="faceConnectionFeedback"
                 class="face-feedback @(string.IsNullOrWhiteSpace(kioskRegistryError) ? "face-feedback--info" : "face-feedback--warning")"
                 role="alert" aria-live="assertive"
                 hidden="@(string.IsNullOrWhiteSpace(kioskRegistryError) ? "hidden" : null)">
                <span class="face-feedback-icon"><i id="faceConnectionFeedbackIcon" class="material-icons" aria-hidden="true">@(browserNotMapped ? "phonelink_setup" : "settings_suggest")</i></span>
                <span class="face-feedback-copy">
                    <strong id="faceConnectionFeedbackTitle">@(browserNotMapped ? "این مرورگر به کیوسک وصل نیست" : "اتصال به دستگاه برقرار نشد")</strong>
                    <span id="faceConnectionFeedbackMessage">@kioskRegistryError</span>
                </span>
            </div>
            @if (kioskId > 0)
            {
                <p class="face-kiosk-id">شناسه کیوسک <strong dir="ltr">@kioskId</strong></p>
            }

            <div>
                <a asp-controller="Authentication" asp-action="Login" class="auth-alt-link">
                    <i class="material-icons" aria-hidden="true">keyboard</i>
                    ورود با نام کاربری و کلمه عبور
                </a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        window.API_BASE_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBaseUrl));
        window.ZP_KIOSK_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(kioskId));
        window.ZP_FACE_CHALLENGE =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FaceChallenge ?? ""));
        window.ZP_LEGACY_FACE_LOGIN =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllowLegacyFaceLogin ?? false));
        window.ZP_KIOSK_CONFIGURED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(kioskId > 0 && !string.IsNullOrWhiteSpace(ViewBag.FaceChallenge as string)));
        console.info("[ورود بیومتریک][Page] صفحه آماده شد.", { kioskId: window.ZP_KIOSK_ID });
        function faceScriptFailed(script) {
            console.error("[ورود بیومتریک][Script] فایل ورود چهره بارگذاری نشد.", script);
            document.getElementById("connectionStatus").textContent = "آماده اتصال نیست";
            const feedback = document.getElementById("faceConnectionFeedback");
            if (feedback) {
                feedback.className = "face-feedback face-feedback--error";
                document.getElementById("faceConnectionFeedbackIcon").textContent = "cloud_off";
                document.getElementById("faceConnectionFeedbackTitle").textContent = "فایل ارتباط با دستگاه بارگذاری نشد";
                document.getElementById("faceConnectionFeedbackMessage").textContent = "اتصال شبکه یا فایل‌های سامانه را بررسی کنید و صفحه را دوباره بارگذاری کنید.";
                feedback.hidden = false;
            }
        }
    </script>
    <script src="~/assets/signalr/signalr2.js" onerror="faceScriptFailed('SignalR')"></script>
    <script src="~/Areas/AuthSystem/js/kiosk.js" asp-append-version="true" onerror="faceScriptFailed('kiosk.js')"></script>
}
