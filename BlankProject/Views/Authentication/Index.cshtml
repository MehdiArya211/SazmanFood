@using Domain.Resources
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = Config.SiteNameFa + " | ورود";
    var hasError = !string.IsNullOrWhiteSpace(ViewBag.Error as string);
}

<div class="auth-panel">
    <div class="row" style="margin:0">
        <section class="col-md-5 auth-visual-side" aria-label="معرفی سامانه">
            <div class="auth-visual-content">
                <div class="auth-eyebrow">مدیریت هوشمند تغذیه</div>
                <h1 class="auth-title">یک تجربه سریع، امن و یکپارچه</h1>
                <p class="auth-subtitle">
                    ثبت آمار، برنامه‌ریزی غذا، مدیریت سهمیه و گزارش‌ها را در یک محیط متمرکز انجام دهید.
                </p>
                <ul class="auth-feature-list">
                    <li><i class="material-icons" aria-hidden="true">verified_user</i><span>ورود امن و کنترل‌شده کاربران</span></li>
                    <li><i class="material-icons" aria-hidden="true">event_available</i><span>مدیریت منظم برنامه و سهمیه غذا</span></li>
                    <li><i class="material-icons" aria-hidden="true">insights</i><span>دسترسی سریع به آمار و گزارش‌ها</span></li>
                </ul>
            </div>
        </section>

        <section class="col-md-7 auth-form-side">
            <div class="auth-eyebrow">ورود کاربران</div>
            <h2 class="auth-title">خوش آمدید</h2>
            <p class="auth-subtitle">برای ورود به سامانه، اطلاعات حساب کاربری خود را وارد کنید.</p>

                @if (hasError)
                {
                    <div class="auth-alert error" role="alert" aria-live="polite">
                    <i class="material-icons" aria-hidden="true">error_outline</i>
                    <span>@ViewBag.Error</span>
                    </div>
                }
           

            <form asp-controller="Authentication"
                  asp-action="Index"
                  asp-route-RetUrl="@Context.Request.Query["RetUrl"]"
                  asp-route-MenuId="@Context.Request.Query["mid"]"
                  method="post"
                  id="loginForm"
                  onsubmit="return Validate();"
                  novalidate>
                <div class="auth-field">
                    <label for="Mobile">نام کاربری</label>
                    <div class="auth-input-wrap">
                        <i class="material-icons" aria-hidden="true">person_outline</i>
                        <input id="Mobile"
                               name="Mobile"
                               type="text"
                               class="auth-input"
                               autocomplete="username"
                               inputmode="text"
                               autofocus
                               required
                               aria-required="true" />
                    </div>
                </div>

                <div class="auth-field">
                    <label for="Password">کلمه عبور</label>
                    <div class="auth-input-wrap">
                        <i class="material-icons" aria-hidden="true">lock_outline</i>
                        <input id="Password"
                               name="Password"
                               type="password"
                               class="auth-input"
                               autocomplete="current-password"
                               required
                               aria-required="true" />
                        <button type="button"
                                id="togglePassword"
                                class="auth-password-toggle"
                                aria-label="نمایش کلمه عبور"
                                aria-pressed="false">
                            <i class="material-icons" aria-hidden="true">visibility</i>
                        </button>
                    </div>
                </div>

                @if (ViewBag.captcha != null)
                {
                    <div class="auth-field">
                        <label for="captcha">کد امنیتی</label>
                        <div class="text-center" style="margin-bottom:12px">
                            <img id="imgcpatcha"
                                 src="@Url.Action("CaptchaImage", "Captcha")"
                                 alt="تصویر کد امنیتی"
                                 style="height:60px;cursor:pointer"
                                 title="برای دریافت کد جدید کلیک کنید" />
                        </div>
                        <div class="auth-input-wrap">
                            <i class="material-icons" aria-hidden="true">security</i>
                            <input id="captcha"
                                   name="captcha"
                                   type="text"
                                   class="auth-input"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   required
                                   aria-required="true" />
                        </div>
                    </div>
                }

                <button id="loginSubmit" type="submit" class="auth-submit">
                    ورود به سامانه
                </button>
            </form>

            <div class="text-center">
                <a asp-controller="Authentication" asp-action="IndexZP" class="auth-alt-link">
                    <i class="material-icons" aria-hidden="true">face</i>
                    ورود با تشخیص چهره
                </a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/assets/VuePersianDateTimePicker/moment/moment.min.js"></script>
    <script src="~/Areas/Root/js/Login.js" asp-append-version="true"></script>
    <script>
        (function () {
            "use strict";

            var toggle = document.getElementById("togglePassword");
            var password = document.getElementById("Password");

            toggle.addEventListener("click", function () {
                var showPassword = password.type === "password";
                password.type = showPassword ? "text" : "password";
                toggle.setAttribute("aria-pressed", String(showPassword));
                toggle.setAttribute("aria-label", showPassword ? "پنهان کردن کلمه عبور" : "نمایش کلمه عبور");
                toggle.querySelector(".material-icons").textContent = showPassword ? "visibility_off" : "visibility";
                password.focus();
            });
        })();
    </script>

    @if (!string.IsNullOrEmpty(Context.Request.Query["newlogin"]))
    {
        <script>
            if (typeof showNotification === "function") {
                showNotification("به دلیل ورود شخصی دیگر با این حساب، از حساب کاربری خارج شدید.", "danger");
            }
        </script>
    }
}
