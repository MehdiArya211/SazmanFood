@{
    Layout = "";
    var message = ViewData["Message"] as string;

}
<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود به سامانه رزرو غذا</title>
    @*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />*@
    <link href="~/assets/fonts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: "Vazirmatn", Tahoma, sans-serif;
            background: linear-gradient(to bottom, #e6f0ff, #ffffff);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            direction: rtl;
            padding: 20px;
        }



        h1 {
            color: #2c3e50;
            font-size: 32px;
            margin-bottom: 50px;
        }

        .btn {
            width: 280px;
            padding: 15px 25px;
            margin: 15px;
            font-size: 20px;
            font-weight: bold;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            color: white;
            background-color: #3498db;
            text-decoration: none;
            user-select: none;
        }

            .btn i {
                font-size: 24px;
            }

        .face-btn {
            background-color: #3498db;
        }

            .face-btn:hover {
                background-color: #2980b9;
            }

        .finger-btn {
            background-color: #2ecc71;
        }

            .finger-btn:hover {
                background-color: #27ae60;
            }

        .admin-link {
            margin-top: 40px;
            font-size: 20px;
            color: #555;
            text-decoration: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s ease;
        }

            .admin-link i {
                font-size: 24px;
                color: #3498db;
            }

            .admin-link:hover {
                color: #3498db;
            }
    </style>
    <style>
        /* استایل لودینگ مودال */
        .loading-modal {
            display: none; /* پیش‌فرض پنهان */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

        .loading-content {
            background: white;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 25px rgba(0,0,0,0.3);
            min-width: 300px;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        .loading-text {
            font-size: 18px;
            color: #333;
            margin-bottom: 10px;
        }

        .loading-subtext {
            font-size: 14px;
            color: #666;
        }

    </style>


    <script src="~/assets/signalr/signalr.min.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder().withUrl("/authHub").build();

        connection.start().then(function () {
            console.log("hub: ", connection);

            signalRfunctionList.loginWithFace(1); // TODO: DEVICE ID

        }).catch(function (err) {
            return console.error(err.toString());
        });

        signalRfunctionList = {
            loginWithFace: function (deviceId) {
                setInterval(() => {
                    connection.invoke("NotifyAuthEvent", deviceId
                    ).catch(function (err) {
                        console.log('NotifyAuthEvent Error', err);
                        return console.error(err.toString());
                    });
                }, 1000);
            },
        }

        connection.on("notifyAuthEvent", function (notic) {
            console.log("📩 NotifyAuthEvent دریافت شد:", notic);

            // نمایش جزئیات در کنسول
            console.log("🆔 وضعیت موفقیت:", notic.isSucces);
            console.log("👤 userId دریافتی:", notic.userId);
            console.log("📅 زمان دریافت:", new Date().toLocaleString());

            if (notic.isSucces === true) {
                // نمایش پیام در صفحه
                console.log("✅ احراز هویت با موفقیت انجام شد. در حال انتقال به داشبورد...");
                document.getElementById("loadingModal").style.display = "flex";

                // بعد از ۵ ثانیه هدایت کن
                setTimeout(() => {
                    location.replace("/Authentication/FinalizeFaceLogin?userId=" + notic.userId);
                }, 5000);
            } else {
                console.warn("❌ احراز هویت ناموفق بود یا notic.isSucces مقدار false دارد");
            }
        });

    </script>

</head>
<body>


    <!-- لودینگ مودال -->
    <div id="loadingModal" class="loading-modal">
        <div class="loading-content">
            <div class="spinner"></div>
            <div class="loading-text">در حال پردازش تشخیص چهره</div>
            <div class="loading-subtext">لطفاً منتظر بمانید...</div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div style="background-color:#ffe0e0; color:#c0392b; padding:15px; border-radius:10px; width:80%; max-width:500px; text-align:center; margin-bottom:20px; font-weight:bold;">
            @message
        </div>
    }
    <h1>ورود به سامانه رزرو غذا</h1>

    <button id="btnFaceLogin" class="btn face-btn">
        <i class="fas fa-user-circle"></i>
        ورود با چهره
    </button>

    <a href="Authentication/Index" class="admin-link">
        <i class="fas fa-key"></i>
        ورود به پنل ادمین
    </a>


    <script>
        document.getElementById("btnFaceLogin").addEventListener("click", function (e) {
            e.preventDefault();

            // نمایش مودال لودینگ از همین الان
            document.getElementById("loadingModal").style.display = "flex";

            fetch("/Authentication/StartFaceLogin", {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    console.log(res.message);
                    // اینجا SignalR هم شروع شده، منتظر notifyAuthEvent می‌مانیم
                } else {
                    document.getElementById("loadingModal").style.display = "none";
                    alert(res.error || "خطا در شروع ورود با چهره");
                }
            })
            .catch(err => {
                document.getElementById("loadingModal").style.display = "none";
                console.error(err);
                alert("خطا در ارتباط با سرور");
            });
        });
    </script>

</body>
</html>


