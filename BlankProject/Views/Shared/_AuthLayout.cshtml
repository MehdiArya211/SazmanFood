@using Domain.Resources
@{
    Layout = null;
    var pageTitle = ViewBag.Title ?? Config.SiteNameFa;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#176b4d" />
    <title>@pageTitle</title>

    <link rel="icon" type="image/png" href="~/assets/img/favicon.ico" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/material-dashboard.css" rel="stylesheet" />
    <link href="~/assets/fonts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/assets/css/googleapis.css?materialIcon" rel="stylesheet" />
    <link href="~/assets/css/bootstrap-rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/my-rtl-custom-style.css" rel="stylesheet" />
    <link href="~/assets/css/auth-pages.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="auth-shell">
    <header class="auth-header">
        <div class="container">
            <a class="auth-brand" href="/" aria-label="صفحه اصلی @Config.SiteNameFa">
                <span class="auth-brand-mark" aria-hidden="true">
                    <i class="material-icons">restaurant_menu</i>
                </span>
                <span class="auth-brand-copy">
                    <strong>@Config.SiteNameFa</strong>
                    <small>سامانه یکپارچه مدیریت تغذیه</small>
                </span>
            </a>
        </div>
    </header>

    <main class="auth-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="auth-footer">
        <div class="container">
            <span>© @DateTime.Now.Year @Config.SiteNameFa ـ تمامی حقوق محفوظ است.</span>
        </div>
    </footer>

    <script src="~/assets/js/jquery-3.1.1.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/bootstrap-notify.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
