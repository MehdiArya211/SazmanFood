@model IEnumerable<DTO.Entities.DiningHallDTO>
@using Services.SessionServices

@{
    ViewData["Title"] = "مدیریت سالن‌های غذاخوری";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var Admin = Context.Session.GetUser();
}

<!-- فیلترها -->
<div class="col-md-12">
    <div class="card filter">
        <div class="col-md-12">
            <div class="col-md-12 text-center filter-caption">
                <a class="btn btn-simple btn-icon pull-right slide-filter"
                   onclick="searchFilter.toggle(this)">
                    <i class="material-icons">arrow_drop_down</i>
                </a>

                ابتدا فیلترهای زیر را انتخاب کرده و سپس بر روی دکمه
                <b>"جستجو"</b>
                کلیک کنید.
            </div>

            <div class="row filter-container">
                <div class="col-md-12">

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            نام سالن:
                        </label>

                        <div>
                            <input id="FilterTitle"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            یگان:
                        </label>

                        <div>
                            <select id="FilterOrgId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true"
                                    asp-items="ViewBag.Org">
                                <option value="">همه</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            نوع پرسنل:
                        </label>

                        <div>
                            <select id="FilterPersonalTypeId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true"
                                    asp-items="ViewBag.PersonalType">
                                <option value="">همه</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            نوع استفاده:
                        </label>

                        <div>
                            <select id="FilterUsageType"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.UsageType">
                                <option value="">همه</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            نوع سالن:
                        </label>

                        <div>
                            <select id="FilterIsInternal"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition">
                                <option value="">همه</option>
                                <option value="True">داخلی یگان</option>
                                <option value="False">عادی</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">
                            وضعیت:
                        </label>

                        <div>
                            <select id="FilterIsActive"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition">
                                <option value="">همه</option>
                                <option value="True">فعال</option>
                                <option value="False">غیرفعال</option>
                            </select>
                        </div>
                    </div>

                </div>

                <div class="col-md-12">
                    <div class="col-md-1 col-sm-4 col-xs-6 form-group">
                        <div>
                            <a class="btn btn-just-icon btn-success filter-search-btn"
                               title="جستجو"
                               data-toggle="tooltip"
                               onclick="diningHall.list.reload()">
                                <i class="material-icons">search</i>
                            </a>
                        </div>
                    </div>

                    <div class="col-md-1 col-sm-4 col-xs-6 form-group">
                        <div>
                            <a class="btn btn-just-icon btn-default filter-search-btn"
                               title="پاک کردن فیلتر"
                               data-toggle="tooltip"
                               onclick="diningHall.filter.clear()">
                                <i class="material-icons">refresh</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="card">
        <div class="card-header card-header-icon"
             data-background-color="purple">
            <i class="material-icons">assignment</i>
        </div>

        <div class="card-content">
            <h4 class="card-title">
                لیست سالن‌های غذاخوری
            </h4>

            <div class="toolbar">
                <p>
                    <a onclick="diningHall.create.loadForm()"
                       class="btn btn-sm btn-success">
                        <i class="material-icons">
                            add_circle_outline
                        </i>

                        افزودن سالن غذاخوری
                    </a>
                </p>
            </div>

            <div class="material-datatables">
                <table id="datatables"
                       class="table table-striped table-no-bordered table-hover"
                       cellspacing="0"
                       style="width:100%">

                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>نام سالن</th>
                            <th>یگان</th>
                            <th>مسئول سالن</th>
                            <th>شماره تماس</th>
                            <th>نوع پرسنل</th>
                            <th>نوع استفاده</th>
                            <th>نوع سالن</th>
                            <th>ظرفیت</th>
                            <th>وضعیت</th>
                            <th class="disabled-sorting"></th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- توکن موردنیاز حذف -->
<form id="delete-token-form">
    @Html.AntiForgeryToken()
</form>

<!-- چارچوب مدال فرم‌ها -->
<div class="modal fade"
     id="base-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="modal5-label"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog modal-lg"
         role="document">

        <div class="modal-content"
             id="modal-form">
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script src="~/assets/js/jquery.datatables.js"></script>

    <script src="~/assets/selectize/selectize.min.js"></script>

    <script src="~/Areas/FoodMg/Dining.js"
            asp-append-version="true"></script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css"
          rel="stylesheet" />

    <style>
        .parameters-section .delete {
            transform: translateY(15px);
        }

        .parameters-section .delete i {
            font-size: 24px;
        }

        #delete-token-form {
            display: none;
        }

        .phone-number {
            direction: ltr;
            text-align: right;
        }
    </style>
}