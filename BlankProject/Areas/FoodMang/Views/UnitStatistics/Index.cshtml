@model IEnumerable<DTO.Entities.UnitStatisticDTO>

@{
    ViewData["Title"] = "مدیریت آمار یگان";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var canRegister = ViewBag.CanRegister == true;
    var canApprove = ViewBag.CanApprove == true;
}

<div class="col-md-12">
    <div class="card filter">
        <div class="col-md-12">
            <div class="col-md-12 text-center filter-caption">
                <a class="btn btn-simple btn-icon pull-right slide-filter"
                   onclick="searchFilter.toggle(this)">
                    <i class="material-icons">arrow_drop_down</i>
                </a>
                فیلترهای مورد نظر را انتخاب کرده و سپس روی دکمه
                <b>جستجو</b>
                کلیک کنید.
            </div>

            <div class="row filter-container">
                <div class="col-md-12">
                    <div class="col-md-3 form-group">
                        <label class="label-control">وضعیت آمار:</label>

                        <select id="FilterStatus"
                                class="selectpicker"
                                data-size="7"
                                data-style="select-with-transition">
                            <option value="">همه</option>
                            <option value="1">ثبت اولیه</option>
                            <option value="2">ارسال شده</option>
                            <option value="3">تأیید نهایی</option>
                            <option value="4">عودت‌شده</option>
                            <option value="5">لغوشده</option>
                        </select>
                    </div>

                    <div class="col-md-3 form-group">
                        <label class="label-control">فعال/غیرفعال:</label>

                        <select id="FilterIsActive"
                                class="selectpicker"
                                data-size="7"
                                data-style="select-with-transition">
                            <option value="">همه</option>
                            <option value="true">فعال</option>
                            <option value="false">غیرفعال</option>
                        </select>
                    </div>

                    <div class="col-md-1 form-group">
                        <a class="btn btn-just-icon btn-success filter-search-btn"
                           title="جستجو"
                           data-toggle="tooltip"
                           onclick="unitStatistic.list.reload()">
                            <i class="material-icons">search</i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="card">
        <div class="card-header card-header-icon"
             data-background-color="purple">
            <i class="material-icons">assignment</i>
        </div>

        <div class="card-content">
            <h4 class="card-title">لیست آمار یگان</h4>

            @if (canRegister)
            {
                <div class="toolbar">
                    <p>
                        <a onclick="unitStatistic.create.loadForm()"
                           class="btn btn-sm btn-success">
                            <i class="material-icons">add_circle_outline</i>
                            ثبت آمار جدید
                        </a>
                    </p>
                </div>
            }

            <div class="material-datatables">
                <table id="datatables"
                       class="table table-striped table-no-bordered table-hover"
                       cellspacing="0"
                       style="width:100%">
                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>یگان</th>
                            <th>تاریخ ثبت</th>
                            <th>ثبت‌کننده</th>
                            <th>تعداد کل کادر</th>
                            <th>تعداد کل وظیفه</th>
                            <th>وضعیت</th>
                            <th>فعال/غیرفعال</th>
                            <th class="disabled-sorting">عملیات</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="base-modal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog"
         style="width:70%"
         role="document">
        <div class="modal-content" id="modal-form"></div>
    </div>
</div>

<div class="modal fade"
     id="details-modal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog"
         style="width:85%"
         role="document">
        <div class="modal-content" id="details-modal-form"></div>
    </div>
</div>

<form id="operation-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        var unitStatisticPermissions = {
            canRegister: @canRegister.ToString().ToLower(),
            canApprove: @canApprove.ToString().ToLower()
        };
    </script>

    <script src="~/assets/js/jquery.datatables.js"></script>
    <script src="~/assets/selectize/selectize.min.js"></script>
    <script src="~/Areas/FoodMg/UnitStatistic.js"
            asp-append-version="true"></script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css"
          rel="stylesheet" />

    <style>
        .statistic-summary {
            background:#f7f7f7;
            border:1px solid #ddd;
            border-radius:4px;
            padding:15px;
            margin-bottom:15px;
        }

        .details-title {
            margin-top:20px;
            margin-bottom:10px;
        }

        .details-total {
            font-weight:bold;
            margin:10px 0 20px;
        }

        .details-valid {
            color:#4caf50;
        }

        .details-invalid {
            color:#f44336;
        }

        .operation-button {
            cursor:pointer;
        }
    </style>
}