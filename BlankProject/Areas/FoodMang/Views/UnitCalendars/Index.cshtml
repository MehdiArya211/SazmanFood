@model IEnumerable<DTO.Entities.UnitCalendarDTO>
@using Domain.Enums

@{
    ViewData["Title"] = "تقویم یگان";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- فیلترها -->
<div class="col-md-12">
    <div class="card filter">
        <div class="col-md-12">
            <div class="col-md-12 text-center filter-caption">
                <a class="btn btn-simple btn-icon pull-right slide-filter"
                   onclick="searchFilter.toggle(this)">
                    <i class="material-icons">arrow_drop_down</i>
                </a>

                ابتدا فیلترهای زیر را انتخاب کرده و سپس روی دکمه
                <b>جستجو</b>
                کلیک کنید.
            </div>

            <div class="row filter-container">
                <div class="col-md-12">

                    <!-- از تاریخ -->
                    <div class="form-group col-md-3">
                        <label class="label-control">
                            از تاریخ:
                        </label>

                        <div id="VueCalendarFromDate"
                             style="display:block">

                            <date-picker
                                v-model="date"
                                type="date"
                                editable="true"
                                auto-submit="true"
                                input-class="form-control"
                                alt-format="YYYY-MM-DD HH:mm:ss"
                                alt-name="FromDate"
                                @@close="onClose">
                            </date-picker>

                        </div>
                    </div>

                    <!-- تا تاریخ -->
                    <div class="form-group col-md-3">
                        <label class="label-control">
                            تا تاریخ:
                        </label>

                        <div id="VueCalendarToDate"
                             style="display:block">

                            <date-picker
                                v-model="date"
                                type="date"
                                editable="true"
                                auto-submit="true"
                                input-class="form-control"
                                alt-format="YYYY-MM-DD HH:mm:ss"
                                alt-name="ToDate"
                                @@close="onClose">
                            </date-picker>

                        </div>
                    </div>

                    <!-- نوع روز -->
                    <div class="form-group col-md-3">
                        <label class="label-control">
                            نوع روز:
                        </label>

                        <select id="FilterDayType"
                                class="selectpicker"
                                data-size="7"
                                data-style="select-with-transition">

                            <option value="">همه</option>

                            <option value="@((int)DayType.Normal)">
                                عادی
                            </option>

                            <option value="@((int)DayType.Holiday)">
                                تعطیل
                            </option>

                            <option value="@((int)DayType.HalfHoliday)">
                                نیمه تعطیل
                            </option>
                        </select>
                    </div>

                    <!-- جستجو -->
                    <div class="col-md-1 form-group">
                        <a class="btn btn-just-icon btn-success filter-search-btn"
                           title="جستجو"
                           data-toggle="tooltip"
                           onclick="unitCalendar.list.reload()">

                            <i class="material-icons">search</i>
                        </a>
                    </div>

                    <!-- پاک‌کردن فیلتر -->
                    <div class="col-md-1 form-group">
                        <a class="btn btn-just-icon btn-default filter-search-btn"
                           title="پاک‌کردن فیلتر"
                           data-toggle="tooltip"
                           onclick="unitCalendar.filter.clear()">

                            <i class="material-icons">clear</i>
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- لیست -->
<div class="col-md-12">
    <div class="card">

        <div class="card-header card-header-icon"
             data-background-color="purple">

            <i class="material-icons">
                calendar_today
            </i>
        </div>

        <div class="card-content">

            <h4 class="card-title">
                تقویم اختصاصی یگان
            </h4>

            <div class="toolbar">
                <p>
                    <a onclick="unitCalendar.create.loadForm()"
                       class="btn btn-sm btn-success">

                        <i class="material-icons">
                            add_circle_outline
                        </i>

                        ثبت وضعیت روز
                    </a>
                </p>
            </div>

            <div class="material-datatables">

                <table id="unit-calendar-table"
                       class="table table-striped table-no-bordered table-hover"
                       cellspacing="0"
                       style="width:100%">

                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>یگان</th>
                            <th>تاریخ</th>
                            <th>نوع روز</th>
                            <th>توضیحات</th>
                            <th class="disabled-sorting">
                                عملیات
                            </th>
                        </tr>
                    </thead>

                    <tbody></tbody>

                </table>

            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade"
     id="base-modal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">

    <div class="modal-dialog"
         style="width:60%"
         role="document">

        <div class="modal-content"
             id="modal-form">
        </div>

    </div>
</div>

<!-- Anti Forgery Token -->
<form id="operation-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script src="~/assets/js/jquery.datatables.js"></script>

    <script src="~/assets/selectize/selectize.min.js"></script>

    <!-- Vue Persian DateTimePicker -->
    <script src="~/assets/VuePersianDateTimePicker/vue.min.js"></script>

    <script src="~/assets/VuePersianDateTimePicker/moment/moment.min.js"></script>

    <script src="~/assets/VuePersianDateTimePicker/moment/moment-jalaali.js"></script>

    <script src="~/assets/VuePersianDateTimePicker/dist/vue-persian-datetime-picker-browser.js"></script>

    <script src="~/Areas/FoodMg/UnitCalendar.js"
            asp-append-version="true">
    </script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css"
          rel="stylesheet" />

    <style>
        .unit-calendar-date-picker {
            display: block;
        }

        .unit-calendar-date-picker input {
            direction: ltr;
            text-align: center;
        }

        .calendar-day-normal {
            color: #4caf50;
            font-weight: bold;
        }

        .calendar-day-holiday {
            color: #f44336;
            font-weight: bold;
        }

        .calendar-day-half-holiday {
            color: #ff9800;
            font-weight: bold;
        }
    </style>
}