@model List<WeeklyFoodReserveDTO>

@using DTO.Entities.FoodReservation
@using Services.SessionServices

@{
    ViewData["Title"] = "مدیریت برنامه غذایی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var user = Context.Session.GetUser();
}

@section styles {
    <style>
        .food-print-page {
            direction: rtl;
            padding: 10px 0 30px;
        }

        .food-print-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            border-radius: 16px;
            padding: 24px 20px;
            margin-bottom: 20px;
            text-align: center;
            box-shadow: 0 8px 24px rgba(30, 60, 114, .18);
        }

        .food-print-header h1 {
            margin: 0 0 8px;
            font-size: 26px;
            font-weight: 900;
        }

        .food-print-header p {
            margin: 0;
            opacity: .9;
        }

        .food-print-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .week-table {
            background: #f8f9fa;
            border-radius: 14px;
            border: 1px solid #e1e8ed;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
        }

        .table-header {
            background: #34495e;
            color: #fff;
            padding: 16px;
            text-align: center;
        }

        .table-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 800;
        }

        .days-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 16px;
            padding: 16px;
        }

        .day-column {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            border: 2px solid transparent;
            box-shadow: 0 5px 18px rgba(0, 0, 0, .08);
        }

        .day-column.past-day {
            opacity: .65;
            filter: grayscale(45%);
            border-color: #e9ecef;
        }

        .day-column.today-day {
            border-color: #28a745;
        }

        .day-column.future-day {
            border-color: #007bff;
        }

        .day-header {
            position: relative;
            color: #fff;
            padding: 18px 16px;
            text-align: center;
        }

        .day-header.past {
            background: linear-gradient(135deg, #adb5bd, #868e96);
        }

        .day-header.today {
            background: linear-gradient(135deg, #28a745, #20c997);
        }

        .day-header.future {
            background: linear-gradient(135deg, #007bff, #6610f2);
        }

        .day-status {
            position: absolute;
            top: 10px;
            left: 12px;
            padding: 4px 9px;
            border-radius: 20px;
            background: rgba(255, 255, 255, .18);
            font-size: 11px;
            font-weight: 800;
        }

        .day-title {
            margin: 0 0 6px;
            font-size: 18px;
            font-weight: 900;
        }

        .day-date {
            margin: 0;
            font-size: 13px;
            opacity: .9;
        }

        .meal-section {
            padding: 16px;
            border-bottom: 1px solid #edf0f3;
        }

        .meal-section:last-child {
            border-bottom: 0;
        }

        .meal-section.breakfast {
            background: #fff8e1;
            border-right: 4px solid #ff9800;
        }

        .meal-section.lunch {
            background: #f3e5f5;
            border-right: 4px solid #9c27b0;
        }

        .meal-section.dinner {
            background: #e8f5e8;
            border-right: 4px solid #4caf50;
        }

        .meal-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .meal-icon {
            font-size: 22px;
        }

        .meal-title {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
            color: #2c3e50;
        }

        .meal-time {
            margin-right: auto;
            font-size: 11px;
            color: #7f8c8d;
        }

        .food-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 7px 0;
            border-bottom: 1px dotted #cfd6dd;
        }

        .food-item:last-child {
            border-bottom: 0;
        }

        .food-label {
            color: #7f8c8d;
            font-size: 12px;
        }

        .food-name {
            color: #2c3e50;
            font-size: 13px;
            font-weight: 800;
        }

        .print-section {
            padding: 14px;
            text-align: center;
            background: #f8f9fa;
            border-top: 1px solid #edf0f3;
        }

        .print-button {
            min-width: 145px;
            border: 0;
            border-radius: 9px;
            padding: 10px 16px;
            background: #34495e;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
        }

        .print-button:disabled {
            background: #bdc3c7;
            cursor: not-allowed;
        }

        .empty-state {
            padding: 70px 20px;
            text-align: center;
            background: #fff;
            border-radius: 14px;
            border: 1px solid #edf0f3;
        }

        .empty-state h2 {
            margin: 0 0 10px;
            color: #6c757d;
            font-size: 22px;
        }

        .empty-state p {
            margin: 0;
            color: #95a5a6;
        }

        @@media (max-width: 768px) {
            .food-print-header h1 {
                font-size: 21px;
            }

            .days-grid {
                grid-template-columns: 1fr;
                padding: 10px;
            }
        }
    </style>
}

<div class="food-print-page">
    <div class="food-print-container">
        <div class="food-print-header">
            <h1>برنامه غذایی هفتگی</h1>
            <p>مشاهده و چاپ ژتون غذا</p>
        </div>

        <div id="weeklyFoodContainer"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const weeklyFoodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<WeeklyFoodReserveDTO>()));

            function getDayStatus(date) {
                const today = new Date();
                const mealDate = new Date(date);

                today.setHours(0, 0, 0, 0);
                mealDate.setHours(0, 0, 0, 0);

                if (mealDate < today) return 'past';
                if (mealDate.getTime() === today.getTime()) return 'today';
                return 'future';
            }

            function getStatusText(status) {
                if (status === 'past') return 'گذشته';
                if (status === 'today') return 'امروز';
                if (status === 'future') return 'آتی';
                return '';
            }

            function getMealIcon(mealTitle) {
                if (mealTitle === 'صبحانه') return '🌅';
                if (mealTitle === 'ناهار') return '🍽️';
                if (mealTitle === 'شام') return '🌙';
                return '🍽️';
            }

            function getMealTime(mealTitle) {
                if (mealTitle === 'صبحانه') return '07:00 - 09:00';
                if (mealTitle === 'ناهار') return '12:00 - 14:00';
                if (mealTitle === 'شام') return '19:00 - 21:00';
                return '';
            }

            function getMealClass(mealTitle) {
                if (mealTitle === 'صبحانه') return 'breakfast';
                if (mealTitle === 'ناهار') return 'lunch';
                if (mealTitle === 'شام') return 'dinner';
                return 'lunch';
            }

            function formatDate(dateString) {
                return new Date(dateString).toLocaleDateString('fa-IR');
            }

            function createFoodRow(label, value) {
                const row = document.createElement('div');
                row.className = 'food-item';

                const labelEl = document.createElement('span');
                labelEl.className = 'food-label';
                labelEl.textContent = label;

                const valueEl = document.createElement('span');
                valueEl.className = 'food-name';
                valueEl.textContent = value || '-';

                row.appendChild(labelEl);
                row.appendChild(valueEl);
                return row;
            }

            function renderWeeklyFood(data) {
                const container = document.getElementById('weeklyFoodContainer');
                container.innerHTML = '';

                if (!Array.isArray(data) || data.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'empty-state';
                    empty.innerHTML = '<h2>📅 هیچ برنامه غذایی یافت نشد</h2><p>برای این هفته هنوز برنامه غذایی تنظیم نشده است.</p>';
                    container.appendChild(empty);
                    return;
                }

                const groupedData = {};

                data.forEach(function (item) {
                    if (!item || !item.Date) return;

                    const dateKey = item.Date.split('T')[0];

                    if (!groupedData[dateKey]) {
                        groupedData[dateKey] = {
                            dayTitle: item.DayTitle,
                            date: item.Date,
                            meals: []
                        };
                    }

                    groupedData[dateKey].meals.push(item);
                });

                const weekTable = document.createElement('div');
                weekTable.className = 'week-table';

                const tableHeader = document.createElement('div');
                tableHeader.className = 'table-header';

                const tableTitle = document.createElement('h2');
                tableTitle.textContent = 'برنامه غذایی هفتگی';

                tableHeader.appendChild(tableTitle);
                weekTable.appendChild(tableHeader);

                const daysGrid = document.createElement('div');
                daysGrid.className = 'days-grid';

                Object.keys(groupedData)
                    .sort(function (a, b) {
                        return new Date(a) - new Date(b);
                    })
                    .forEach(function (dateKey) {
                        const dayInfo = groupedData[dateKey];
                        const status = getDayStatus(dayInfo.date);
                        const canPrint = status !== 'past';

                        const dayColumn = document.createElement('div');
                        dayColumn.className = 'day-column ' + status + '-day';

                        const dayHeader = document.createElement('div');
                        dayHeader.className = 'day-header ' + status;

                        const statusEl = document.createElement('div');
                        statusEl.className = 'day-status';
                        statusEl.textContent = getStatusText(status);

                        const dayTitle = document.createElement('h3');
                        dayTitle.className = 'day-title';
                        dayTitle.textContent = dayInfo.dayTitle || '-';

                        const dayDate = document.createElement('p');
                        dayDate.className = 'day-date';
                        dayDate.textContent = formatDate(dayInfo.date);

                        dayHeader.appendChild(statusEl);
                        dayHeader.appendChild(dayTitle);
                        dayHeader.appendChild(dayDate);
                        dayColumn.appendChild(dayHeader);

                        const mealsContainer = document.createElement('div');
                        mealsContainer.className = 'meals-container';

                        const mealOrder = {
                            'صبحانه': 1,
                            'ناهار': 2,
                            'شام': 3
                        };

                        dayInfo.meals
                            .slice()
                            .sort(function (a, b) {
                                return (mealOrder[a.MealTitle] || 99) - (mealOrder[b.MealTitle] || 99);
                            })
                            .forEach(function (meal) {
                                const mealSection = document.createElement('div');
                                mealSection.className = 'meal-section ' + getMealClass(meal.MealTitle);

                                const mealHeader = document.createElement('div');
                                mealHeader.className = 'meal-header';

                                const mealIcon = document.createElement('div');
                                mealIcon.className = 'meal-icon';
                                mealIcon.textContent = getMealIcon(meal.MealTitle);

                                const mealTitle = document.createElement('h4');
                                mealTitle.className = 'meal-title';
                                mealTitle.textContent = meal.MealTitle || '-';

                                const mealTime = document.createElement('span');
                                mealTime.className = 'meal-time';
                                mealTime.textContent = getMealTime(meal.MealTitle);

                                mealHeader.appendChild(mealIcon);
                                mealHeader.appendChild(mealTitle);
                                mealHeader.appendChild(mealTime);

                                mealSection.appendChild(mealHeader);
                                mealSection.appendChild(createFoodRow('غذای اصلی:', meal.MainFood));

                                if (meal.Dessert && meal.Dessert !== '-') {
                                    mealSection.appendChild(createFoodRow('دسر:', meal.Dessert));
                                }

                                mealSection.appendChild(createFoodRow('همراه:', meal.SideDish));
                                mealsContainer.appendChild(mealSection);
                            });

                        dayColumn.appendChild(mealsContainer);

                        const foodReserveIds = dayInfo.meals
                            .map(function (meal) {
                                return meal.FoodReserveDetaileId;
                            })
                            .filter(function (id) {
                                return id !== null && id !== undefined && id !== '';
                            });

                        const printSection = document.createElement('div');
                        printSection.className = 'print-section';

                        const printButton = document.createElement('button');
                        printButton.type = 'button';
                        printButton.className = 'print-button';

                        if (canPrint && foodReserveIds.length > 0) {
                            printButton.textContent = '🖨️ چاپ کل روز';
                            printButton.addEventListener('click', function () {
                                const ids = foodReserveIds.join(',');
                                window.location.href =
                                    '/ShowReserveManagment/ShowReserve/PrintMeal?foodReserveDetaileIds=' +
                                    encodeURIComponent(ids);
                            });
                        } else {
                            printButton.textContent = '❌ غیرفعال';
                            printButton.disabled = true;
                        }

                        printSection.appendChild(printButton);
                        dayColumn.appendChild(printSection);
                        daysGrid.appendChild(dayColumn);
                    });

                weekTable.appendChild(daysGrid);
                container.appendChild(weekTable);
            }

            document.addEventListener('DOMContentLoaded', function () {
                renderWeeklyFood(weeklyFoodData);
            });
        })();
    </script>
}
