@model List<DTO.Entities.FoodReservation.WeeklyFoodReserveDTO>
@using System.Globalization
@using System.Collections.Generic

@{
    Layout = null;
    ViewData["Title"] = "چاپ رسید رزرو غذا";
    var persianCalendar = new PersianCalendar();
    var printUserName = ViewBag.PrintUserName as string ?? "-";
    var deliveryQrImages = ViewBag.DeliveryQrImages as IReadOnlyDictionary<long, string>
        ?? new Dictionary<long, string>();
    var logoutFaceAfterPrint = ViewBag.FaceLoginLogoutAfterPrint is bool logout && logout;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>چاپ رسید رزرو غذا</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            background: #eef1f4;
            color: #111;
            font-family: Tahoma, Arial, sans-serif;
            direction: rtl;
        }
        .print-toolbar {
            background: #fff;
            border-bottom: 1px solid #dbe1e8;
            padding: 16px;
            text-align: center;
            line-height: 1.8;
        }
        .print-toolbar strong { font-size: 16px; }
        .print-toolbar p {
            margin: 5px auto 12px;
            max-width: 580px;
            color: #5b6570;
            font-size: 13px;
        }
        .print-toolbar button {
            padding: 11px 28px;
            border: 0;
            border-radius: 10px;
            background: #145844;
            color: #fff;
            font: bold 14px Tahoma, sans-serif;
            cursor: pointer;
        }
        .tickets { padding: 20px 8px; display: flex; flex-direction: column; align-items: center; }
        .ticket {
            background: #fff;
            width: 50mm;
            max-width: 100%;
            margin: 0 auto 18px;
            padding: 2.5mm;
            border: 1px solid #d9dee3;
            border-radius: 6px;
            box-shadow: 0 6px 22px rgba(0, 0, 0, .10);
            font-size: 9pt;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }
        .ticket-header { text-align: center; }
        .ticket-brand {
            margin: 0;
            font-size: 9pt;
            font-weight: 700;
        }
        .ticket h1 {
            margin: 2px 0 0;
            font-size: 13pt;
            line-height: 1.6;
            font-weight: 900;
        }
        .ticket-caption {
            margin: 2px 0 0;
            font-size: 8pt;
            color: #333;
        }
        .ticket-number {
            text-align: center;
            border: 1.5px solid #111;
            border-radius: 5px;
            padding: 5px 3px 6px;
            margin: 10px 0;
        }
        .ticket-number .label {
            display: block;
            font-size: 8pt;
            line-height: 1.5;
        }
        .ticket-number .value {
            display: block;
            font: bold 16pt Tahoma, Arial, sans-serif;
            line-height: 1.45;
            direction: ltr;
        }
        .ticket-meta { margin: 0; }
        .ticket-meta .row {
            display: flex;
            align-items: flex-start;
            gap: 4px;
            padding: 3px 0;
            border-bottom: 1px dotted #777;
        }
        .ticket-meta .row:last-child { border-bottom: 0; }
        .ticket-meta dt {
            flex: 0 0 32%;
            font-size: 8pt;
            color: #333;
        }
        .ticket-meta dd {
            flex: 1;
            margin: 0;
            font-size: 9pt;
            font-weight: 700;
            text-align: left;
        }
        .ticket-food {
            border-top: 2px solid #111;
            border-bottom: 2px solid #111;
            padding: 7px 0;
            margin: 9px 0 6px;
            text-align: center;
        }
        .ticket-food .label { display: block; font-size: 8pt; }
        .ticket-food .value {
            display: block;
            font-size: 11pt;
            font-weight: 900;
            line-height: 1.7;
        }
        .ticket-addon {
            display: flex;
            justify-content: space-between;
            gap: 6px;
            padding: 2px 0;
            font-size: 9pt;
        }
        .ticket-addon strong { text-align: left; }
        .ticket-footer {
            border-top: 1px dashed #555;
            margin-top: 10px;
            padding-top: 8px;
            text-align: center;
            font-size: 8pt;
        }
        .delivery-qr {
            display: block;
            width: 30mm;
            height: 30mm;
            margin: 0 auto 4px;
            image-rendering: crisp-edges;
        }
        .ticket-footer p { margin: 3px 0 0; }
        .ticket-end {
            border-top: 1px dashed #777;
            margin-top: 10px;
        }
        @@media print {
            @@page { size: 58mm auto; margin: 0; }
            html, body {
                background: #fff;
                margin: 0;
                padding: 0;
                width: 58mm;
                min-width: 58mm;
            }
            .print-toolbar { display: none !important; }
            .tickets { padding: 0; }
            .ticket {
                display: block;
                border: 0;
                border-radius: 0;
                box-shadow: none;
                margin: 0 auto;
                padding: 2.5mm;
                width: 50mm;
                max-width: 50mm;
                break-inside: avoid;
                page-break-inside: avoid;
                break-after: page;
                page-break-after: always;
            }
            .ticket:last-child {
                break-after: auto;
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <strong>پیش‌نمایش رسید غذا</strong>
        <p>
            فاکتور با چاپگر همین دستگاه چاپ می‌شود. اگر پنجره چاپ باز شد، چاپگر متصل به این دستگاه را انتخاب کنید.
            اندازه کاغذ چاپگر حرارتی را روی ۵۸ میلی‌متر تنظیم کنید.
        </p>
        <p>هر بار درخواست چاپ، یک نوبت از سقف مجاز ژتون را مصرف می‌کند.</p>
    </div>

    <div class="tickets">
        @foreach (var item in Model)
        {
            var foodDate = item.Date;
            var persianDate =
                $"{persianCalendar.GetYear(foodDate)}/" +
                $"{persianCalendar.GetMonth(foodDate):00}/" +
                $"{persianCalendar.GetDayOfMonth(foodDate):00}";

            <article class="ticket">
                <header class="ticket-header">
                    <p class="ticket-brand">سامانه تغذیه</p>
                    <h1>رسید رزرو غذا</h1>
                    <p class="ticket-caption">لطفاً این رسید را تا زمان دریافت غذا نگه دارید</p>
                </header>
                <div class="ticket-number">
                    <span class="label">شماره رزرو</span>
                    <span class="value">@item.FoodReserveDetaileId</span>
                </div>
                <div class="ticket-number">نوبت چاپ این ژتون: <strong>@item.PrintCount</strong></div>
                <dl class="ticket-meta">
                    <div class="row"><dt>نام</dt><dd>@printUserName</dd></div>
                    <div class="row"><dt>تاریخ</dt><dd>@persianDate</dd></div>
                    <div class="row"><dt>روز</dt><dd>@item.DayTitle</dd></div>
                    <div class="row"><dt>وعده</dt><dd>@item.MealTitle</dd></div>
                </dl>
                <div class="ticket-food">
                    <span class="label">غذای اصلی</span>
                    <span class="value">@item.MainFood</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(item.Dessert) && item.Dessert != "-")
                {
                    <div class="ticket-addon"><span>دسر</span><strong>@item.Dessert</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(item.SideDish) && item.SideDish != "-")
                {
                    <div class="ticket-addon"><span>دورچین</span><strong>@item.SideDish</strong></div>
                }
                <footer class="ticket-footer">
                @if (deliveryQrImages.TryGetValue(item.FoodReserveDetaileId, out var qrImage))
                {
                    <img class="delivery-qr" src="data:image/png;base64,@qrImage"
                         alt="QR تحویل غذا" />
                    <p>برای تحویل غذا اسکن شود</p>
                }
                else
                {
                    <p>از همراهی شما سپاسگزاریم</p>
                }
                </footer>
                <div class="ticket-end" aria-hidden="true"></div>
            </article>
        }
    </div>
    <script>
        window.addEventListener('load', function () {
            if (window.opener) {
                window.opener.postMessage({ type: 'food-ticket-print', items:
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => new { x.FoodReserveDetaileId, x.PrintCount })))
                }, window.location.origin);
            }
            const logoutFaceAfterPrint = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(logoutFaceAfterPrint));
            window.foodTicketLogoutAfterPrint = logoutFaceAfterPrint;
            // مرورگر روی همان دستگاهی که کاربر وارد شده است چاپ را شروع می‌کند.
            window.print();
        });
        window.addEventListener('afterprint', function () {
            if (window.foodTicketLogoutAfterPrint && window.opener) {
                window.opener.postMessage({
                    type: 'food-ticket-printed-logout',
                }, window.location.origin);
            }
            window.close();
        });
    </script>
</body>
</html>
