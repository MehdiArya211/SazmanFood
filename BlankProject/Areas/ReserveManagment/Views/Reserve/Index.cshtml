@model DTO.Entities.FoodPlanReserveDTO
@using DTO.Entities
@using Domain.Entities.FoodManage
@using Services.SessionServices
@using System.Globalization
@using DTO.Base

@{
    ViewData["Title"] = "ثبت برنامه غذایی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var Admin = Context.Session.GetUser();
    var allowedSlots =
        ViewBag.AllowedReservationSlots as HashSet<string> ??
        new HashSet<string>();
    var foodPolicy = ViewBag.FoodPolicy as FoodTimingPolicyDTO ?? new FoodTimingPolicyDTO();
    var foodTitles = ViewBag.FoodTitles as Dictionary<long, string> ?? new Dictionary<long, string>();
    var todayIranDate = ViewBag.TodayIranDate is DateTime iranDate ? iranDate : DateTime.Today;
    var saveSuccess = TempData["Success"] as string;
    var saveError = TempData["Error"] as string;
    var hasReservationQuota =
        ViewBag.HasReservationQuota is bool hasQuota && hasQuota;
    var freeReservationEnabled =
        ViewBag.FreeReservationEnabled is bool freeMode && freeMode;
    var reservationDeadlineEnabled =
        ViewBag.ReservationDeadlineEnabled is bool deadlineMode && deadlineMode;
    var closedReservationSlotsCount =
        ViewBag.ClosedReservationSlotsCount is int closedCount ? closedCount : 0;
    var weekOffset = ViewBag.WeekOffset is int selectedWeek ? selectedWeek : 0;
    var isFaceKiosk = ViewBag.IsFaceKiosk is bool faceKiosk && faceKiosk;
    var selectedDay = ViewBag.SelectedDay is int chosenDay ? chosenDay : 1;
    var maxPrintCount = ViewBag.MaxPrintCount is int printLimit ? printLimit : 3;
    var printableDetailIds = ViewBag.PrintableDetailIds as HashSet<long> ?? new HashSet<long>();

    DateTime weekStartDate = ViewBag.WeekStartDate != null
        ? (DateTime)ViewBag.WeekStartDate
        : DateTime.Now.Date;

    var pc = new PersianCalendar();
    string Shamsi(DateTime dt) => $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
    var shownDate = weekStartDate.AddDays(selectedDay - 1).Date;
    var previousAllowed = shownDate > todayIranDate;
    var nextAllowed = weekOffset == 0 || selectedDay < 7;
    var previousWeek = selectedDay == 1 ? weekOffset - 1 : weekOffset;
    var previousDay = selectedDay == 1 ? 7 : selectedDay - 1;
    var nextWeek = selectedDay == 7 ? weekOffset + 1 : weekOffset;
    var nextDay = selectedDay == 7 ? 1 : selectedDay + 1;
    var kioskHasEditableMeal = Model.Meals.Any(meal =>
        allowedSlots.Contains($"{shownDate:yyyyMMdd}_{meal.Id}") &&
        (Model.ExistingReserveDetails?.FirstOrDefault(detail =>
            detail.DayId == Model.Days.FirstOrDefault(d => d.Code == selectedDay)?.Id &&
            detail.MealId == meal.Id)?.PrintCount ?? 0) == 0);
}

@section styles {
    <style>
        .reserve-page {
            direction: rtl;
            padding: 10px 0 30px;
            font-family: Vazirmatn, IRANSans, Tahoma, Arial, sans-serif;
        }

        .reserve-container {
            width: 100%;
            max-width: 1380px;
            margin: 0 auto;
        }

        .reserve-card {
            background: #fff;
            border: 1px solid #e9edf3;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(34, 52, 73, .08);
            overflow: hidden;
        }

        .reserve-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 22px 24px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border-bottom: 1px solid #edf1f5;
        }

        .reserve-week-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;
        }

        .reserve-week-navigation {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #d7e2ee;
            background: #fff;
            border-radius: 8px;
            color: #34657e;
            padding: 8px 11px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }
        .reserve-week-navigation:hover,
        .reserve-week-navigation:focus {
            text-decoration: none;
            background: #eaf4fb;
            color: #175578;
        }

        .reserve-head-main {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .reserve-head-icon {
            width: 52px;
            height: 52px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 52px;
            background: linear-gradient(135deg, #ec407a, #ab47bc);
            color: #fff;
            box-shadow: 0 8px 18px rgba(171, 71, 188, .22);
        }

        .reserve-head-icon .material-icons {
            font-size: 28px;
        }

        .reserve-title {
            margin: 0 0 5px;
            color: #243447;
            font-size: 22px;
            line-height: 1.5;
            font-weight: 900;
        }

        .reserve-hint {
            color: #708090;
            font-size: 13px;
            line-height: 1.9;
        }

        .reserve-week {
            display: flex;
            align-items: center;
            gap: 7px;
            flex: 0 0 auto;
            padding: 9px 14px;
            border: 1px solid #dce6f4;
            border-radius: 12px;
            background: #fff;
            color: #40546a;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 3px 12px rgba(45, 67, 91, .05);
        }

        .reserve-week .material-icons {
            font-size: 19px;
            color: #7e57c2;
        }

        .reserve-guide {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            padding: 14px 24px;
            background: #fbfcfe;
            border-bottom: 1px solid #edf1f5;
        }

        .reserve-guide-item {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #637385;
            font-size: 12px;
            line-height: 1.7;
        }

        .reserve-guide-number {
            width: 27px;
            height: 27px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 27px;
            background: #eef2ff;
            color: #5e35b1;
            font-weight: 900;
        }

        .reserve-content {
            padding: 18px;
        }

        .reserve-alert {
            border: 0;
            border-radius: 12px;
            box-shadow: 0 5px 16px rgba(0, 0, 0, .05);
            font-weight: 700;
        }

        .reserve-table-wrap {
            border: 1px solid #e7ebf0;
            border-radius: 14px;
            overflow: hidden;
            background: #fff;
        }

        .reserve-table {
            margin: 0;
            border: 0 !important;
        }

        .reserve-table > thead > tr > th {
            padding: 13px 12px !important;
            border: 0 !important;
            border-bottom: 1px solid #e9edf2 !important;
            background: #f6f8fb;
            color: #4b5c6f;
            font-size: 13px;
            font-weight: 900;
            text-align: right;
        }

        .reserve-table > tbody > tr.meal-row > td {
            padding: 14px 12px !important;
            border-color: #edf0f4 !important;
            vertical-align: middle !important;
            background: #fff;
        }

        .reserve-table > tbody > tr.meal-row:hover > td {
            background: #fcfdff;
        }

        .day-header-row td {
            padding: 12px 0 7px !important;
            border: 0 !important;
            background: #fff !important;
        }

        .day-header {
            padding: 0 !important;
        }

        .day-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 54px;
            padding: 11px 14px;
            border-radius: 12px;
            background: linear-gradient(135deg, #7e57c2, #ec407a);
            color: #fff;
            box-shadow: 0 5px 15px rgba(126, 87, 194, .17);
        }

        .day-title {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .day-name {
            font-size: 15px;
            font-weight: 900;
        }

        .day-date {
            padding: 4px 9px;
            border: 1px solid rgba(255, 255, 255, .28);
            border-radius: 20px;
            background: rgba(255, 255, 255, .14);
            font-size: 12px;
            font-weight: 700;
        }

        .delete-day-btn {
            margin: 0 !important;
            padding: 7px 10px !important;
            border: 1px solid rgba(255, 255, 255, .38) !important;
            border-radius: 9px !important;
            background: rgba(255, 255, 255, .14) !important;
            box-shadow: none !important;
            color: #fff !important;
            font-size: 11px !important;
        }

        .delete-day-btn:hover {
            background: rgba(255, 255, 255, .24) !important;
        }

        .meal-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 86px;
            padding: 7px 11px;
            border: 1px solid #dfe7f1;
            border-radius: 9px;
            background: #f7f9fc;
            color: #34495e;
            font-size: 13px;
            font-weight: 900;
        }

        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .chip-item {
            display: inline-flex;
            position: relative;
        }

        .chip-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .chip {
            min-height: 35px;
            margin: 0;
            padding: 7px 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e0e6ed;
            border-radius: 10px;
            background: #fff;
            color: #4c5d70;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.6;
            cursor: pointer;
            user-select: none;
            transition: all .18s ease;
        }

        .chip:hover {
            border-color: #b9c8da;
            background: #f8faff;
            transform: translateY(-1px);
        }

        .chip-input:focus + .chip {
            box-shadow: 0 0 0 3px rgba(66, 133, 244, .12);
        }

        .chip-input:checked + .chip {
            border-color: #7e57c2;
            background: #f1ecfb;
            color: #5e35b1;
            box-shadow: 0 3px 10px rgba(126, 87, 194, .12);
        }

        .chip-input:checked + .chip:before {
            content: "✓";
            margin-left: 6px;
            font-weight: 900;
        }

        .chip-muted {
            border-color: #f1dfcf;
            background: #fffaf5;
            color: #9a6333;
        }

        .chip-input:checked + .chip-muted {
            border-color: #d9a36f;
            background: #fff3e7;
            color: #8a4b18;
        }

        .chip-input:disabled + .chip {
            cursor: default;
        }

        .chip-input:disabled + .chip:hover {
            transform: none;
        }

        .chip-selected-readonly {
            border-color: #7e57c2;
            background: #f1ecfb;
            color: #5e35b1;
            cursor: default;
        }

        .reserve-readonly-note {
            display: block;
            margin-top: 5px;
            color: #758293;
            font-size: 11px;
        }

        .swal2-modal {
            border-radius: 18px;
            font-family: Vazirmatn, IRANSans, Tahoma, Arial, sans-serif;
        }

        .swal2-modal .swal2-title {
            color: #26384d;
            font-weight: 900;
        }

        .reserve-sticky {
            position: sticky;
            bottom: 10px;
            z-index: 30;
            margin-top: 16px;
        }

        .reserve-sticky-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 12px 14px;
            border: 1px solid #e2e8ef;
            border-radius: 13px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 8px 24px rgba(31, 45, 61, .11);
            backdrop-filter: blur(8px);
        }

        .reserve-sticky-text {
            color: #697a8c;
            font-size: 12px;
            line-height: 1.8;
        }

        .reserve-selection-count {
            display: inline-flex;
            align-items: center;
            margin-right: 8px;
            padding: 3px 9px;
            border-radius: 20px;
            background: #eef2ff;
            color: #5e35b1;
            font-weight: 900;
            white-space: nowrap;
        }

        .reserve-submit {
            min-width: 210px;
            margin: 0 !important;
            border-radius: 10px !important;
            font-weight: 900 !important;
        }

        .kiosk-day-navigation, .kiosk-print-actions { display: none; }
        .reserve-page.kiosk-mode { padding: 4px 0 16px; }
        .kiosk-mode .reserve-container { max-width: 1200px; }
        .kiosk-mode .reserve-card { border-radius: 24px; border-color: #e0e9f0; box-shadow: 0 18px 45px rgba(34,52,73,.12); }
        .kiosk-mode .reserve-head { padding: 15px 22px; background: linear-gradient(115deg,#f0faff,#fff2f7); }
        .kiosk-mode .reserve-guide, .kiosk-mode .reserve-week-actions, .kiosk-mode .reserve-table thead { display: none; }
        .kiosk-mode .reserve-title { font-size: 25px; }
        .kiosk-mode .reserve-content { padding: 12px 20px; }
        .kiosk-day-navigation { align-items: center; justify-content: space-between; gap: 12px; padding: 14px 20px; background: #f6fafd; border-bottom: 1px solid #e5eef5; }
        .kiosk-mode .kiosk-day-navigation, .kiosk-mode .kiosk-print-actions { display: flex; }
        .kiosk-nav-button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-width: 145px; min-height: 64px; padding: 8px 18px; border-radius: 17px; background: #fff; color: #285975; border: 2px solid #bcd5e5; font-size: 18px; font-weight: 900; text-decoration: none; touch-action: manipulation; }
        .kiosk-nav-button:hover, .kiosk-nav-button:focus { color: #174461; background: #e7f5fc; text-decoration: none; }
        .kiosk-nav-button[disabled] { opacity: .42; cursor: not-allowed; }
        .kiosk-current-day { text-align: center; color: #234358; font-weight: 900; font-size: 25px; line-height: 1.5; }
        .kiosk-current-day small { display: block; color: #71859a; font-size: 15px; }
        .kiosk-mode .reserve-table, .kiosk-mode .reserve-table tbody, .kiosk-mode .reserve-table tr.day-header-row, .kiosk-mode .reserve-table tr.meal-row { display: block; width: 100%; }
        .kiosk-mode .reserve-table { border: 0; }
        .kiosk-mode .reserve-table .kiosk-hidden { display: none !important; }
        .kiosk-mode .reserve-table tr.day-header-row td { display: block; width: 100%; }
        .kiosk-mode .reserve-table tr.meal-row { margin: 12px 0; border: 1px solid #e5ebf1; border-radius: 17px; background: #fff; overflow: hidden; box-shadow: 0 4px 16px rgba(31,45,61,.05); }
        .kiosk-mode .reserve-table > tbody > tr.meal-row > td { border: 0 !important; border-bottom: 1px solid #edf1f5 !important; min-width: 0; }
        .kiosk-mode .reserve-table > tbody > tr.meal-row > td:last-child { border-bottom: 0 !important; }
        .kiosk-mode .chip { min-height: 56px; padding: 12px 18px; font-size: 16px; touch-action: manipulation; }
        .kiosk-mode .chips { gap: 10px; }
        .kiosk-mode .reserve-sticky { bottom: 6px; }
        .kiosk-mode .reserve-sticky-inner { gap: 12px; }
        .kiosk-mode .reserve-submit { min-height: 62px; font-size: 18px; }
        .kiosk-print-actions { align-items: center; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
        .kiosk-print-button { min-height: 58px; padding: 10px 20px; border-radius: 15px; border: 0; background: #16846e; color: #fff; font-size: 17px; font-weight: 900; touch-action: manipulation; }
        .kiosk-print-button[aria-disabled="true"] { background: #aebcc4; color: #263a47; }
        .kiosk-print-count { font-size: 14px; color: #576b7b; font-weight: 700; }
        @@media (max-width: 991px) {
            .reserve-head {
                align-items: stretch;
                flex-direction: column;
                padding: 18px;
            }

            .reserve-week {
                width: fit-content;
            }

            .reserve-guide {
                grid-template-columns: 1fr;
                padding: 12px 18px;
            }

            .reserve-content {
                padding: 12px;
            }

            .reserve-table-wrap {
                overflow: visible;
                border: 0;
                background: transparent;
            }

            .reserve-table,
            .reserve-table tbody {
                display: block;
                width: 100%;
            }

            .reserve-table thead {
                display: none;
            }

            .reserve-table tr.day-header-row {
                display: block;
                margin-top: 15px;
            }

            .reserve-table tr.day-header-row:first-child {
                margin-top: 0;
            }

            .reserve-table tr.day-header-row td {
                display: block;
                width: 100%;
            }

            .reserve-table tr.meal-row {
                display: block;
                margin: 9px 0 14px;
                overflow: hidden;
                border: 1px solid #e7ebf0;
                border-radius: 13px;
                background: #fff;
                box-shadow: 0 4px 14px rgba(31, 45, 61, .05);
            }

            .reserve-table > tbody > tr.meal-row > td {
                display: grid;
                grid-template-columns: 88px minmax(0, 1fr);
                gap: 10px;
                width: 100%;
                padding: 11px 12px !important;
                border: 0 !important;
                border-bottom: 1px solid #eef1f4 !important;
                text-align: right;
            }

            .reserve-table > tbody > tr.meal-row > td:last-child {
                border-bottom: 0 !important;
            }

            .reserve-table tr.meal-row td:before {
                content: attr(data-label);
                padding-top: 7px;
                color: #8291a2;
                font-size: 11px;
                font-weight: 900;
            }

            .meal-badge {
                width: fit-content;
                min-width: 0;
            }

            .chips {
                gap: 6px;
            }

            .chip {
                min-height: 34px;
                padding: 6px 9px;
                font-size: 11px;
            }

            .reserve-sticky {
                bottom: 5px;
            }

            .reserve-sticky-inner {
                align-items: stretch;
                flex-direction: column;
            }

            .reserve-submit {
                width: 100%;
                min-width: 0;
            }
        }

        @@media (max-width: 575px) {
            .kiosk-day-navigation { padding: 9px; gap: 6px; }
            .kiosk-nav-button { min-width: 87px; min-height: 56px; padding: 7px; font-size: 14px; }
            .kiosk-current-day { font-size: 17px; }
            .kiosk-current-day small { font-size: 11px; }
            .reserve-page {
                padding-top: 2px;
            }

            .reserve-container {
                padding: 0 5px;
            }

            .reserve-card {
                border-radius: 13px;
            }

            .reserve-head {
                padding: 14px;
            }

            .reserve-head-icon {
                width: 44px;
                height: 44px;
                flex-basis: 44px;
                border-radius: 12px;
            }

            .reserve-title {
                font-size: 18px;
            }

            .reserve-hint {
                font-size: 11px;
            }

            .reserve-week {
                width: 100%;
                justify-content: center;
                font-size: 11px;
            }

            .day-header-inner {
                min-height: 50px;
                padding: 9px 10px;
            }

            .day-name {
                font-size: 13px;
            }

            .reserve-table > tbody > tr.meal-row > td {
                grid-template-columns: 70px minmax(0, 1fr);
                padding: 9px 10px !important;
            }
        }
    </style>
}
@if (freeReservationEnabled)
{
    <div class="alert alert-info text-center" role="status" style="font-size:14px;font-weight:700;">
        <i class="material-icons" aria-hidden="true">info</i>
        حالت رزرو آزاد فعال است؛ رزرو طبق برنامه غذایی موجود و بدون نیاز به سهمیه فردی انجام می‌شود.
    </div>
}
@if (reservationDeadlineEnabled)
{
    <div class="alert alert-info text-center" role="status"
         style="font-size:13px;font-weight:700;">
        <i class="material-icons" aria-hidden="true">schedule</i>
        محدودیت مهلت رزرو فعال است.
        @if (closedReservationSlotsCount > 0)
        {
            <span>
                مهلت رزرو @closedReservationSlotsCount وعده از این هفته به پایان رسیده است.
                رزروهای ثبت‌شده قبلی این روزها حذف نمی‌شوند و ژتون آن‌ها طبق شرایط چاپ قابل دریافت است.
            </span>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(ViewBag.QuotaError as string))
{
    <div class="alert alert-warning text-center" role="alert" style="font-size:16px;font-weight:bold;">
        <i class="material-icons" aria-hidden="true">warning</i>
        @ViewBag.QuotaError
    </div>
}

@if (saveSuccess != null || saveError != null)
{
    <div id="reserve-result" data-kind="@(saveSuccess != null ? "success" : "error")"
         data-message="@(saveSuccess ?? saveError)" hidden></div>
}

<form method="post"
      action="@Url.Action("Index", "Reserve", new { area = "ReserveManagment" })"
      class="reserve-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="week" value="@weekOffset" />
    @if (isFaceKiosk) { <input type="hidden" name="selectedDay" value="@selectedDay" /> }
    <div class="reserve-page @(isFaceKiosk ? "kiosk-mode" : "")">
    <div class="container reserve-container">
        <div class="reserve-card">

            <div class="reserve-head">
                <div class="reserve-head-main">
                    <div class="reserve-head-icon">
                        <i class="material-icons">restaurant_menu</i>
                    </div>
                    <div>
                        <h2 class="reserve-title">@(isFaceKiosk ? "رزرو غذای امروز و روزهای آینده" : "رزرو غذای هفتگی")</h2>
                        <div class="reserve-hint">
                            برای هر وعده غذای موردنظر را انتخاب کنید. انتخاب دسر و دورچین اختیاری است.
                        </div>
                    </div>
                </div>

                <div class="reserve-week-actions">
                    <div class="reserve-week">
                        <i class="material-icons">date_range</i>
                        <span>@Shamsi(weekStartDate) تا @Shamsi(weekStartDate.AddDays(6))</span>
                    </div>
                    @if (weekOffset == 0)
                    {
                        <a class="reserve-week-navigation"
                           href="@Url.Action("Index", "Reserve", new { area = "ReserveManagment", week = 1 })">
                            هفته آینده <i class="material-icons" aria-hidden="true">chevron_left</i>
                        </a>
                    }
                    else
                    {
                        <a class="reserve-week-navigation"
                           href="@Url.Action("Index", "Reserve", new { area = "ReserveManagment", week = 0 })">
                            <i class="material-icons" aria-hidden="true">chevron_right</i> هفته جاری
                        </a>
                    }
                </div>
            </div>

            @if (isFaceKiosk)
            {
                <nav class="kiosk-day-navigation" aria-label="انتخاب روز رزرو">
                    @if (previousAllowed)
                    {
                        <a class="kiosk-nav-button" href="@Url.Action("Index", "Reserve", new { area = "ReserveManagment", week = previousWeek, day = previousDay })">→ روز قبل</a>
                    }
                    else
                    {
                        <button class="kiosk-nav-button" type="button" disabled title="رزرو روزهای گذشته امکان‌پذیر نیست">→ روز قبل</button>
                    }
                    <span class="kiosk-current-day" aria-live="polite">
                        @(Model.Days.FirstOrDefault(x => x.Code == selectedDay)?.Title ?? "روز انتخاب‌شده")
                        <small>@Shamsi(shownDate) @(shownDate == todayIranDate ? "· امروز" : "")</small>
                    </span>
                    @if (nextAllowed)
                    {
                        <a class="kiosk-nav-button" href="@Url.Action("Index", "Reserve", new { area = "ReserveManagment", week = nextWeek, day = nextDay })">روز بعد ←</a>
                    }
                    else
                    {
                        <button class="kiosk-nav-button" type="button" disabled title="برنامه فعلاً تا پایان هفته آینده قابل نمایش است">روز بعد ←</button>
                    }
                </nav>
            }

            <div class="reserve-guide">
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۱</span>
                        <span>همه روزهای هفته و وعده‌های قابل نمایش را می‌بینید؛ موارد بسته فقط برای مشاهده هستند.</span>
                </div>
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۲</span>
                    <span>غذای اصلی را انتخاب کنید و در صورت تمایل دسر و دورچین را مشخص کنید.</span>
                </div>
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۳</span>
                    <span>در پایان، انتخاب‌ها را بررسی و روی ثبت نهایی بزنید.</span>
                </div>
            </div>

            <div class="reserve-content">
            <div class="table-responsive reserve-table-wrap">
                <table class="table table-bordered reserve-table">
                    <thead>
                        <tr>
                            <th style="width:140px">وعده</th>
                            <th>غذا</th>
                            @if (foodPolicy.DessertVisible) { <th>دسر</th> }
                            @if (foodPolicy.SideDishVisible) { <th>دورچین</th> }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var day in Model.Days.OrderBy(day => day.Code))
                        {
                            var dayDate = weekStartDate.AddDays(day.Code - 1).Date;
                            var dayReservations = Model.ExistingReserveDetails?.Count(detail => detail.DayId == day.Id) ?? 0;

                            <tr class="day-header-row @(isFaceKiosk && day.Code != selectedDay ? "kiosk-hidden" : "")">
                                <td colspan="@(2 + (foodPolicy.DessertVisible ? 1 : 0) + (foodPolicy.SideDishVisible ? 1 : 0))" class="day-header">
                                    <div class="day-header-inner">
                                        <div class="day-title">
                                            <span class="day-name">@day.Title</span>
                                            <span class="day-date">@Shamsi(dayDate)</span>
                                            @if (foodPolicy.BlockPastDays && dayDate < todayIranDate)
                                            {
                                                <span class="day-date">گذشته · فقط مشاهده</span>
                                            }
                                        </div>

                                        <span class="label label-default day-reservation-status" data-day-id="@day.Id" data-count="@dayReservations">
                                            @(dayReservations > 0 ? $"{dayReservations} وعده رزروشده" : "رزروی ثبت نشده است")
                                        </span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var meal in Model.Meals.Where(meal => foodPolicy.IsMealVisible(meal.Code)).OrderBy(meal => meal.SortName))
                            {
                                var mainFoods = GetFoodListForMeal(day.Id, meal.Id, Model);
                                var savedDetail = Model.ExistingReserveDetails?.FirstOrDefault(detail =>
                                    detail.DayId == day.Id && detail.MealId == meal.Id);
                                var mealCanChange = allowedSlots.Contains($"{dayDate:yyyyMMdd}_{meal.Id}");
                                var mealEditable = mealCanChange && mainFoods.Count > 0 &&
                                    (savedDetail == null || savedDetail.PrintCount == 0);
                                <tr class="meal-row @(isFaceKiosk && day.Code != selectedDay ? "kiosk-hidden" : "")" data-day-id="@day.Id" data-meal-id="@meal.Id" data-reserved="@(savedDetail != null ? "true" : "false")">
                                    <td data-label="وعده">
                                        <span class="meal-badge">@meal.Title</span>
                                        @if (!mealEditable)
                                        {
                                            <small class="reserve-readonly-note">@(savedDetail != null && savedDetail.PrintCount > 0 ? $"ژتون چاپ شده (نوبت {savedDetail.PrintCount})؛ فقط مشاهده" : foodPolicy.BlockPastDays && dayDate < todayIranDate ? "فقط مشاهده" : "انتخاب غیرفعال")</small>
                                        }
                                        @if (isFaceKiosk && savedDetail != null && day.Code == selectedDay)
                                        {
                                            var canPrintDetail = printableDetailIds.Contains(savedDetail.Id);
                                            var printMessage = savedDetail.PrintCount >= maxPrintCount
                                                ? $"سقف {maxPrintCount} بار چاپ این ژتون پر شده است."
                                                : "چاپ این ژتون اکنون مجاز نیست؛ زمان چاپ یا سهمیه را بررسی کنید.";
                                            <div class="kiosk-print-actions">
                                                <button type="button" class="kiosk-print-button" data-detail-id="@savedDetail.Id"
                                                        aria-disabled="@(canPrintDetail ? "false" : "true")"
                                                        data-message="@printMessage">🖨 چاپ ژتون</button>
                                                <span class="kiosk-print-count">نوبت چاپ: @savedDetail.PrintCount از @maxPrintCount</span>
                                            </div>
                                        }
                                    </td>

                                    <!-- غذا -->
                                    <td data-label="غذا">
                                        <div class="chips">
                                            @foreach (var food in mainFoods)
                                            {
                                                var id = $"Main_{day.Id}_{meal.Id}_{food.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="MainFood_@day.Id@meal.Id"
                                                           value="@food.Id"
                                                           disabled="@(!mealEditable)"
                                                           @(IsFoodSelected(day.Id, meal.Id, food.Id, "Main", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@food.Title</label>
                                                </span>
                                            }
                                            @if (savedDetail?.MainFoodId is long savedMainId && !mainFoods.Any(x => x.Id == savedMainId))
                                            {
                                                <span class="chip chip-selected-readonly">✓ @(foodTitles.TryGetValue(savedMainId, out var mainTitle) ? mainTitle : "غذای انتخاب‌شده قبلی")</span>
                                            }
                                            @if (mainFoods.Count == 0 && savedDetail?.MainFoodId == null)
                                            {
                                                <span class="reserve-readonly-note">برنامه غذایی ثبت نشده است.</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- دسر -->
                                    @if (foodPolicy.DessertVisible)
                                    {
                                    <td data-label="دسر">
                                        <div class="chips">
                                            @foreach (var dessert in GetDessertListForMeal(day.Id, meal.Id, Model))
                                            {
                                                var id = $"Dessert_{day.Id}_{meal.Id}_{dessert.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="Dessert_@day.Id@meal.Id"
                                                           value="@dessert.Id"
                                                       disabled="@(!mealEditable || !foodPolicy.DessertReservable)"
                                                           @(IsFoodSelected(day.Id, meal.Id, dessert.Id, "Dessert", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@dessert.Title</label>
                                                </span>
                                            }
                                            @if (savedDetail?.DessertId is long savedDessertId &&
                                                !GetDessertListForMeal(day.Id, meal.Id, Model).Any(x => x.Id == savedDessertId))
                                            {
                                                <span class="chip chip-selected-readonly">✓ @(foodTitles.TryGetValue(savedDessertId, out var dessertTitle) ? dessertTitle : "دسر انتخاب‌شده قبلی")</span>
                                            }

                                            @{
                                                var noneDessertId = $"Dessert_{day.Id}_{meal.Id}_none";
                                                var dessertNoneChecked =
                                                Model.ExistingReserveDetails != null &&
                                                Model.ExistingReserveDetails.Any(d => d.DayId == day.Id && d.MealId == meal.Id && !d.DessertId.HasValue);
                                            }
                                            <span class="chip-item">
                                                <input class="chip-input" type="radio" id="@noneDessertId"
                                                       name="Dessert_@day.Id@meal.Id" value=""
                                                       disabled="@(!mealEditable || !foodPolicy.DessertReservable)"
                                                       @(dessertNoneChecked ? "checked" : "") />
                                                <label class="chip chip-muted" for="@noneDessertId">بدون دسر</label>
                                            </span>
                                        </div>
                                        @if (!foodPolicy.DessertReservable) { <small>رزرو دسر غیرفعال است</small> }
                                    </td>
                                    }

                                    <!-- دورچین -->
                                    @if (foodPolicy.SideDishVisible)
                                    {
                                    <td data-label="دورچین">
                                        <div class="chips">
                                            @foreach (var side in GetSideDishListForMeal(day.Id, meal.Id, Model))
                                            {
                                                var id = $"SideDish_{day.Id}_{meal.Id}_{side.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="SideDish_@day.Id@meal.Id"
                                                           value="@side.Id"
                                                           disabled="@(!mealEditable || !foodPolicy.SideDishReservable)"
                                                           @(IsFoodSelected(day.Id, meal.Id, side.Id, "SideDish", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@side.Title</label>
                                                </span>
                                            }
                                            @if (savedDetail?.SideDishId is long savedSideId &&
                                                !GetSideDishListForMeal(day.Id, meal.Id, Model).Any(x => x.Id == savedSideId))
                                            {
                                                <span class="chip chip-selected-readonly">✓ @(foodTitles.TryGetValue(savedSideId, out var sideTitle) ? sideTitle : "دورچین انتخاب‌شده قبلی")</span>
                                            }

                                            @{
                                                var noneSideId = $"SideDish_{day.Id}_{meal.Id}_none";
                                                var sideNoneChecked =
                                                Model.ExistingReserveDetails != null &&
                                                Model.ExistingReserveDetails.Any(d => d.DayId == day.Id && d.MealId == meal.Id && !d.SideDishId.HasValue);
                                            }
                                            <span class="chip-item">
                                                <input class="chip-input" type="radio" id="@noneSideId"
                                                       name="SideDish_@day.Id@meal.Id" value=""
                                                       disabled="@(!mealEditable || !foodPolicy.SideDishReservable)"
                                                       @(sideNoneChecked ? "checked" : "") />
                                                <label class="chip chip-muted" for="@noneSideId">بدون دورچین</label>
                                            </span>
                                        </div>
                                        @if (!foodPolicy.SideDishReservable) { <small>رزرو دورچین غیرفعال است</small> }
                                    </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="reserve-sticky">
                <div class="reserve-sticky-inner">
                    <div class="reserve-sticky-text">
                        انتخاب‌ها را بررسی کنید و سپس ثبت نهایی را انجام دهید.
                        <span class="reserve-selection-count">
                            <span id="selectionCount">۰</span>&nbsp;وعده انتخاب‌شده
                        </span>
                    </div>
                    @if (hasReservationQuota && (!isFaceKiosk || kioskHasEditableMeal))
                    {
                        <button type="submit" class="btn btn-rose btn-lg reserve-submit">
                            <i class="material-icons" style="vertical-align:middle;font-size:19px;">check_circle</i>
                            ثبت نهایی برنامه غذایی
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-default btn-lg" disabled>
                            @((reservationDeadlineEnabled || foodPolicy.BlockPastDays) && closedReservationSlotsCount > 0
                                ? "مهلت رزرو به پایان رسیده است"
                                : "در این هفته موردی برای رزرو در دسترس نیست")
                        </button>
                    }
                </div>
            </div>
            </div>

        </div>
    </div>
    </div>
</form>
@if (isFaceKiosk)
{
    <form id="kiosk-print-form" method="post" target="food-print-window"
          action="@Url.Action("PrintPreview", "ShowReserve", new { area = "ShowReserveManagment" })" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="foodReserveDetaileIds" />
    </form>
}

@functions {
    public List<Foods> GetFoodListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.MainFoods.TryGetValue((dayId, mealId), out var foods))
            return foods;
        return new List<Foods>();
    }

    public List<Foods> GetDessertListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.Desserts.TryGetValue((dayId, mealId), out var desserts))
            return desserts;
        return new List<Foods>();
    }

    public List<Foods> GetSideDishListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.SideDishes.TryGetValue((dayId, mealId), out var sides))
            return sides;
        return new List<Foods>();
    }

    public bool IsFoodSelected(long dayId, long mealId, long foodId, string foodType, FoodPlanReserveDTO model)
    {
        if (model.ExistingReserveDetails == null || !model.ExistingReserveDetails.Any())
            return false;

        var detail = model.ExistingReserveDetails.FirstOrDefault(d => d.DayId == dayId && d.MealId == mealId);
        if (detail == null)
            return false;

        switch (foodType)
        {
            case "Main": return detail.MainFoodId == foodId;
            case "Dessert": return detail.DessertId == foodId;
            case "SideDish": return detail.SideDishId == foodId;
            default: return false;
        }
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var kioskMode = @(isFaceKiosk ? "true" : "false");
            if (kioskMode) $('.meal-row.kiosk-hidden input').prop('disabled', true);
            $('.kiosk-print-button').on('click', function () {
                var button = this;
                if (button.getAttribute('aria-disabled') === 'true') {
                    swal({ title: 'چاپ ژتون ممکن نیست', text: button.dataset.message,
                        type: 'warning', confirmButtonText: 'متوجه شدم' });
                    return;
                }
                var printWindow = window.open('', 'food-print-window');
                if (!printWindow) {
                    swal({ title: 'پنجره چاپ باز نشد', text: 'اجازه باز شدن پنجره چاپ را در مرورگر فعال کنید.',
                        type: 'warning', confirmButtonText: 'متوجه شدم' });
                    return;
                }
                var printForm = document.getElementById('kiosk-print-form');
                printForm.elements.namedItem('foodReserveDetaileIds').value = button.dataset.detailId;
                printForm.submit();
            });
            if (kioskMode) window.addEventListener('message', function (event) {
                if (event.origin !== window.location.origin || !event.data ||
                    event.data.type !== 'food-ticket-print') return;
                // ثبت شمارنده در سرور انجام شده است؛ صفحه دوباره وضعیت مجاز چاپ را می‌خواند.
                window.location.reload();
            });
            function toPersianNumber(value) {
                return String(value).replace(/\d/g, function (digit) {
                    return '۰۱۲۳۴۵۶۷۸۹'[digit];
                });
            }

            function updateSelectionCount() {
                var count = $('input[name^="MainFood_"]:checked:not(:disabled)').filter(function () {
                    return $(this).val();
                }).length + $('.meal-row[data-reserved="true"]:not(.kiosk-hidden) .chip-selected-readonly').filter(function () {
                    return $(this).closest('td').attr('data-label') === 'غذا';
                }).length;

                $('#selectionCount').text(toPersianNumber(count));
            }

            function clearOptionalChoices(input) {
                if (input.name.indexOf('MainFood_') !== 0) return;
                $(input).closest('.meal-row').find('input[name^="Dessert_"], input[name^="SideDish_"]')
                    .prop('checked', false);
            }

            // کلیک دوم روی گزینهٔ انتخاب‌شده، همان رادیو را بدون ارسال درخواست لغو می‌کند.
            $('.meal-row .chip-item label.chip').on('click', function (event) {
                var input = document.getElementById(this.htmlFor);
                if (!input || input.disabled || !input.checked || !input.value) return;
                event.preventDefault();
                input.checked = false;
                clearOptionalChoices(input);
                updateSelectionCount();
            });

            $('.meal-row input[type="radio"]').on('keydown', function (event) {
                if (event.key !== ' ' || !this.checked || !this.value) return;
                event.preventDefault();
                this.checked = false;
                clearOptionalChoices(this);
                updateSelectionCount();
            }).on('change', updateSelectionCount);
            updateSelectionCount();

            var result = document.getElementById('reserve-result');
            if (result) {
                swal({
                    title: result.dataset.kind === 'success' ? 'برنامه غذایی ثبت شد' : 'ثبت برنامه غذایی انجام نشد',
                    text: result.dataset.message,
                    type: result.dataset.kind,
                    confirmButtonText: 'متوجه شدم',
                    confirmButtonClass: 'btn btn-rose',
                    buttonsStyling: false
                });
            }

        });
    </script>
}
