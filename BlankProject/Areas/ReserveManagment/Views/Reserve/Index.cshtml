@model DTO.Entities.FoodPlanReserveDTO
@using DTO.Entities
@using Domain.Entities.FoodManage
@using Services.SessionServices
@using System.Globalization

@{
    ViewData["Title"] = "ثبت برنامه غذایی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var Admin = Context.Session.GetUser();
    var allowedSlots =
        ViewBag.AllowedReservationSlots as HashSet<string> ??
        new HashSet<string>();
    var hasReservationQuota =
        ViewBag.HasReservationQuota is bool hasQuota && hasQuota;

    var canReserve =
        ViewBag.CanReserve is bool allowed && allowed;

    DateTime weekStartDate = ViewBag.WeekStartDate != null
        ? (DateTime)ViewBag.WeekStartDate
        : DateTime.Now.Date;

    var pc = new PersianCalendar();
    string Shamsi(DateTime dt) => $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
}

@section styles {
    <style>
        .reserve-page {
            direction: rtl;
            padding: 10px 0 30px;
            font-family: Vazirmatn, IRANSans, Tahoma, Arial, sans-serif;
        }

        .reserve-container {
            width: 100%;
            max-width: 1380px;
            margin: 0 auto;
        }

        .reserve-card {
            background: #fff;
            border: 1px solid #e9edf3;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(34, 52, 73, .08);
            overflow: hidden;
        }

        .reserve-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 22px 24px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border-bottom: 1px solid #edf1f5;
        }

        .reserve-head-main {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .reserve-head-icon {
            width: 52px;
            height: 52px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 52px;
            background: linear-gradient(135deg, #ec407a, #ab47bc);
            color: #fff;
            box-shadow: 0 8px 18px rgba(171, 71, 188, .22);
        }

        .reserve-head-icon .material-icons {
            font-size: 28px;
        }

        .reserve-title {
            margin: 0 0 5px;
            color: #243447;
            font-size: 22px;
            line-height: 1.5;
            font-weight: 900;
        }

        .reserve-hint {
            color: #708090;
            font-size: 13px;
            line-height: 1.9;
        }

        .reserve-week {
            display: flex;
            align-items: center;
            gap: 7px;
            flex: 0 0 auto;
            padding: 9px 14px;
            border: 1px solid #dce6f4;
            border-radius: 12px;
            background: #fff;
            color: #40546a;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 3px 12px rgba(45, 67, 91, .05);
        }

        .reserve-week .material-icons {
            font-size: 19px;
            color: #7e57c2;
        }

        .reserve-guide {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            padding: 14px 24px;
            background: #fbfcfe;
            border-bottom: 1px solid #edf1f5;
        }

        .reserve-guide-item {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #637385;
            font-size: 12px;
            line-height: 1.7;
        }

        .reserve-guide-number {
            width: 27px;
            height: 27px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 27px;
            background: #eef2ff;
            color: #5e35b1;
            font-weight: 900;
        }

        .reserve-content {
            padding: 18px;
        }

        .reserve-alert {
            border: 0;
            border-radius: 12px;
            box-shadow: 0 5px 16px rgba(0, 0, 0, .05);
            font-weight: 700;
        }

        .reserve-table-wrap {
            border: 1px solid #e7ebf0;
            border-radius: 14px;
            overflow: hidden;
            background: #fff;
        }

        .reserve-table {
            margin: 0;
            border: 0 !important;
        }

        .reserve-table > thead > tr > th {
            padding: 13px 12px !important;
            border: 0 !important;
            border-bottom: 1px solid #e9edf2 !important;
            background: #f6f8fb;
            color: #4b5c6f;
            font-size: 13px;
            font-weight: 900;
            text-align: right;
        }

        .reserve-table > tbody > tr.meal-row > td {
            padding: 14px 12px !important;
            border-color: #edf0f4 !important;
            vertical-align: middle !important;
            background: #fff;
        }

        .reserve-table > tbody > tr.meal-row:hover > td {
            background: #fcfdff;
        }

        .day-header-row td {
            padding: 12px 0 7px !important;
            border: 0 !important;
            background: #fff !important;
        }

        .day-header {
            padding: 0 !important;
        }

        .day-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 54px;
            padding: 11px 14px;
            border-radius: 12px;
            background: linear-gradient(135deg, #7e57c2, #ec407a);
            color: #fff;
            box-shadow: 0 5px 15px rgba(126, 87, 194, .17);
        }

        .day-title {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .day-name {
            font-size: 15px;
            font-weight: 900;
        }

        .day-date {
            padding: 4px 9px;
            border: 1px solid rgba(255, 255, 255, .28);
            border-radius: 20px;
            background: rgba(255, 255, 255, .14);
            font-size: 12px;
            font-weight: 700;
        }

        .delete-day-btn {
            margin: 0 !important;
            padding: 7px 10px !important;
            border: 1px solid rgba(255, 255, 255, .38) !important;
            border-radius: 9px !important;
            background: rgba(255, 255, 255, .14) !important;
            box-shadow: none !important;
            color: #fff !important;
            font-size: 11px !important;
        }

        .delete-day-btn:hover {
            background: rgba(255, 255, 255, .24) !important;
        }

        .meal-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 86px;
            padding: 7px 11px;
            border: 1px solid #dfe7f1;
            border-radius: 9px;
            background: #f7f9fc;
            color: #34495e;
            font-size: 13px;
            font-weight: 900;
        }

        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .chip-item {
            display: inline-flex;
            position: relative;
        }

        .chip-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .chip {
            min-height: 35px;
            margin: 0;
            padding: 7px 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e0e6ed;
            border-radius: 10px;
            background: #fff;
            color: #4c5d70;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.6;
            cursor: pointer;
            user-select: none;
            transition: all .18s ease;
        }

        .chip:hover {
            border-color: #b9c8da;
            background: #f8faff;
            transform: translateY(-1px);
        }

        .chip-input:focus + .chip {
            box-shadow: 0 0 0 3px rgba(66, 133, 244, .12);
        }

        .chip-input:checked + .chip {
            border-color: #7e57c2;
            background: #f1ecfb;
            color: #5e35b1;
            box-shadow: 0 3px 10px rgba(126, 87, 194, .12);
        }

        .chip-input:checked + .chip:before {
            content: "✓";
            margin-left: 6px;
            font-weight: 900;
        }

        .chip-muted {
            border-color: #f1dfcf;
            background: #fffaf5;
            color: #9a6333;
        }

        .chip-input:checked + .chip-muted {
            border-color: #d9a36f;
            background: #fff3e7;
            color: #8a4b18;
        }

        .reserve-sticky {
            position: sticky;
            bottom: 10px;
            z-index: 30;
            margin-top: 16px;
        }

        .reserve-sticky-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 12px 14px;
            border: 1px solid #e2e8ef;
            border-radius: 13px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 8px 24px rgba(31, 45, 61, .11);
            backdrop-filter: blur(8px);
        }

        .reserve-sticky-text {
            color: #697a8c;
            font-size: 12px;
            line-height: 1.8;
        }

        .reserve-selection-count {
            display: inline-flex;
            align-items: center;
            margin-right: 8px;
            padding: 3px 9px;
            border-radius: 20px;
            background: #eef2ff;
            color: #5e35b1;
            font-weight: 900;
            white-space: nowrap;
        }

        .reserve-submit {
            min-width: 210px;
            margin: 0 !important;
            border-radius: 10px !important;
            font-weight: 900 !important;
        }

        @@media (max-width: 991px) {
            .reserve-head {
                align-items: stretch;
                flex-direction: column;
                padding: 18px;
            }

            .reserve-week {
                width: fit-content;
            }

            .reserve-guide {
                grid-template-columns: 1fr;
                padding: 12px 18px;
            }

            .reserve-content {
                padding: 12px;
            }

            .reserve-table-wrap {
                overflow: visible;
                border: 0;
                background: transparent;
            }

            .reserve-table,
            .reserve-table tbody {
                display: block;
                width: 100%;
            }

            .reserve-table thead {
                display: none;
            }

            .reserve-table tr.day-header-row {
                display: block;
                margin-top: 15px;
            }

            .reserve-table tr.day-header-row:first-child {
                margin-top: 0;
            }

            .reserve-table tr.day-header-row td {
                display: block;
                width: 100%;
            }

            .reserve-table tr.meal-row {
                display: block;
                margin: 9px 0 14px;
                overflow: hidden;
                border: 1px solid #e7ebf0;
                border-radius: 13px;
                background: #fff;
                box-shadow: 0 4px 14px rgba(31, 45, 61, .05);
            }

            .reserve-table > tbody > tr.meal-row > td {
                display: grid;
                grid-template-columns: 88px minmax(0, 1fr);
                gap: 10px;
                width: 100%;
                padding: 11px 12px !important;
                border: 0 !important;
                border-bottom: 1px solid #eef1f4 !important;
                text-align: right;
            }

            .reserve-table > tbody > tr.meal-row > td:last-child {
                border-bottom: 0 !important;
            }

            .reserve-table tr.meal-row td:before {
                content: attr(data-label);
                padding-top: 7px;
                color: #8291a2;
                font-size: 11px;
                font-weight: 900;
            }

            .meal-badge {
                width: fit-content;
                min-width: 0;
            }

            .chips {
                gap: 6px;
            }

            .chip {
                min-height: 34px;
                padding: 6px 9px;
                font-size: 11px;
            }

            .reserve-sticky {
                bottom: 5px;
            }

            .reserve-sticky-inner {
                align-items: stretch;
                flex-direction: column;
            }

            .reserve-submit {
                width: 100%;
                min-width: 0;
            }
        }

        @@media (max-width: 575px) {
            .reserve-page {
                padding-top: 2px;
            }

            .reserve-container {
                padding: 0 5px;
            }

            .reserve-card {
                border-radius: 13px;
            }

            .reserve-head {
                padding: 14px;
            }

            .reserve-head-icon {
                width: 44px;
                height: 44px;
                flex-basis: 44px;
                border-radius: 12px;
            }

            .reserve-title {
                font-size: 18px;
            }

            .reserve-hint {
                font-size: 11px;
            }

            .reserve-week {
                width: 100%;
                justify-content: center;
                font-size: 11px;
            }

            .day-header-inner {
                min-height: 50px;
                padding: 9px 10px;
            }

            .day-name {
                font-size: 13px;
            }

            .reserve-table > tbody > tr.meal-row > td {
                grid-template-columns: 70px minmax(0, 1fr);
                padding: 9px 10px !important;
            }
        }
    </style>
}
@if (!string.IsNullOrWhiteSpace(ViewBag.QuotaError as string))
{
    <div class="alert alert-warning text-center" role="alert" style="font-size:16px;font-weight:bold;">
        <i class="material-icons" aria-hidden="true">warning</i>
        @ViewBag.QuotaError
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!canReserve)
{
    <div class="alert alert-info text-center reserve-alert" role="alert">
        <i class="material-icons" aria-hidden="true">info</i>
        صفحه رزرو برای شما قابل مشاهده است، اما انتخاب و ثبت برنامه غذایی فقط برای نقش «رزروکننده غذا» فعال است.
    </div>
}

<form method="post" class="reserve-form">
    <div class="reserve-page">
    <div class="container reserve-container">
        <div class="reserve-card">

            <div class="reserve-head">
                <div class="reserve-head-main">
                    <div class="reserve-head-icon">
                        <i class="material-icons">restaurant_menu</i>
                    </div>
                    <div>
                        <h2 class="reserve-title">رزرو غذای هفتگی</h2>
                        <div class="reserve-hint">
                            برای هر وعده غذای موردنظر را انتخاب کنید. انتخاب دسر و دورچین اختیاری است.
                        </div>
                    </div>
                </div>

                <div class="reserve-week">
                    <i class="material-icons">date_range</i>
                    <span>@Shamsi(weekStartDate) تا @Shamsi(weekStartDate.AddDays(6))</span>
                </div>
            </div>

            <div class="reserve-guide">
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۱</span>
                    <span>روز و وعده‌ای که برای شما سهمیه دارد نمایش داده می‌شود.</span>
                </div>
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۲</span>
                    <span>غذای اصلی را انتخاب کنید و در صورت تمایل دسر و دورچین را مشخص کنید.</span>
                </div>
                <div class="reserve-guide-item">
                    <span class="reserve-guide-number">۳</span>
                    <span>در پایان، انتخاب‌ها را بررسی و روی ثبت نهایی بزنید.</span>
                </div>
            </div>

            <div class="reserve-content">
            <fieldset @(canReserve ? null : "disabled")>
            <div class="table-responsive reserve-table-wrap">
                <table class="table table-bordered reserve-table">
                    <thead>
                        <tr>
                            <th style="width:140px">وعده</th>
                            <th>غذا</th>
                            <th>دسر</th>
                            <th>دورچین</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var day in Model.Days.Where(day =>
                            Model.Meals.Any(meal =>
                                allowedSlots.Contains(
                                    $"{weekStartDate.AddDays(day.Code - 1):yyyyMMdd}_{meal.Id}"))))
                        {
                            var dayDate = weekStartDate.AddDays(day.Code - 1).Date;
                            var dayHasQuota = true;

                            <tr class="day-header-row">
                                <td colspan="4" class="day-header">
                                    <div class="day-header-inner">
                                        <div class="day-title">
                                            <span class="day-name">@day.Title</span>
                                            <span class="day-date">@Shamsi(dayDate)</span>
                                        </div>

                                        @if (dayHasQuota)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-danger delete-day-btn"
                                                    data-day-id="@day.Id"
                                                    data-day-title="@day.Title">
                                                حذف روز
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="label label-default">برای این روز سهمیه ثبت نشده است</span>
                                        }
                                    </div>
                                </td>
                            </tr>

                            @foreach (var meal in Model.Meals.Where(
                                meal => allowedSlots.Contains($"{dayDate:yyyyMMdd}_{meal.Id}")))
                            {
                                <tr class="meal-row">
                                    <td data-label="وعده">
                                        <span class="meal-badge">@meal.Title</span>
                                    </td>

                                    <!-- غذا -->
                                    <td data-label="غذا">
                                        <div class="chips">
                                            @foreach (var food in GetFoodListForMeal(day.Id, meal.Id, Model))
                                            {
                                                var id = $"Main_{day.Id}_{meal.Id}_{food.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="MainFood_@day.Id@meal.Id"
                                                           value="@food.Id"
                                                           @(IsFoodSelected(day.Id, meal.Id, food.Id, "Main", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@food.Title</label>
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <!-- دسر -->
                                    <td data-label="دسر">
                                        <div class="chips">
                                            @foreach (var dessert in GetDessertListForMeal(day.Id, meal.Id, Model))
                                            {
                                                var id = $"Dessert_{day.Id}_{meal.Id}_{dessert.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="Dessert_@day.Id@meal.Id"
                                                           value="@dessert.Id"
                                                           @(IsFoodSelected(day.Id, meal.Id, dessert.Id, "Dessert", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@dessert.Title</label>
                                                </span>
                                            }

                                            @{
                                                var noneDessertId = $"Dessert_{day.Id}_{meal.Id}_none";
                                                var dessertNoneChecked =
                                                Model.ExistingReserveDetails != null &&
                                                Model.ExistingReserveDetails.Any(d => d.DayId == day.Id && d.MealId == meal.Id && !d.DessertId.HasValue);
                                            }
                                            <span class="chip-item">
                                                <input class="chip-input" type="radio" id="@noneDessertId"
                                                       name="Dessert_@day.Id@meal.Id" value=""
                                                       @(dessertNoneChecked ? "checked" : "") />
                                                <label class="chip chip-muted" for="@noneDessertId">بدون دسر</label>
                                            </span>
                                        </div>
                                    </td>

                                    <!-- دورچین -->
                                    <td data-label="دورچین">
                                        <div class="chips">
                                            @foreach (var side in GetSideDishListForMeal(day.Id, meal.Id, Model))
                                            {
                                                var id = $"SideDish_{day.Id}_{meal.Id}_{side.Id}";
                                                <span class="chip-item">
                                                    <input class="chip-input" type="radio" id="@id"
                                                           name="SideDish_@day.Id@meal.Id"
                                                           value="@side.Id"
                                                           @(IsFoodSelected(day.Id, meal.Id, side.Id, "SideDish", Model) ? "checked" : "") />
                                                    <label class="chip" for="@id">@side.Title</label>
                                                </span>
                                            }

                                            @{
                                                var noneSideId = $"SideDish_{day.Id}_{meal.Id}_none";
                                                var sideNoneChecked =
                                                Model.ExistingReserveDetails != null &&
                                                Model.ExistingReserveDetails.Any(d => d.DayId == day.Id && d.MealId == meal.Id && !d.SideDishId.HasValue);
                                            }
                                            <span class="chip-item">
                                                <input class="chip-input" type="radio" id="@noneSideId"
                                                       name="SideDish_@day.Id@meal.Id" value=""
                                                       @(sideNoneChecked ? "checked" : "") />
                                                <label class="chip chip-muted" for="@noneSideId">بدون دورچین</label>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="reserve-sticky">
                <div class="reserve-sticky-inner">
                    <div class="reserve-sticky-text">
                        انتخاب‌ها را بررسی کنید و سپس ثبت نهایی را انجام دهید.
                        <span class="reserve-selection-count">
                            <span id="selectionCount">۰</span>&nbsp;وعده انتخاب‌شده
                        </span>
                    </div>
                    @if (hasReservationQuota)
                    {
                        <button type="submit" class="btn btn-rose btn-lg reserve-submit">
                            <i class="material-icons" style="vertical-align:middle;font-size:19px;">check_circle</i>
                            ثبت نهایی برنامه غذایی
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-default btn-lg" disabled>
                            سهمیه‌ای برای رزرو وجود ندارد
                        </button>
                    }
                </div>
            </div>
            </fieldset>
            </div>

        </div>
    </div>
    </div>
</form>

@functions {
    public List<Foods> GetFoodListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.MainFoods.TryGetValue((dayId, mealId), out var foods))
            return foods;
        return new List<Foods>();
    }

    public List<Foods> GetDessertListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.Desserts.TryGetValue((dayId, mealId), out var desserts))
            return desserts;
        return new List<Foods>();
    }

    public List<Foods> GetSideDishListForMeal(long dayId, long mealId, FoodPlanReserveDTO model)
    {
        if (model.SideDishes.TryGetValue((dayId, mealId), out var sides))
            return sides;
        return new List<Foods>();
    }

    public bool IsFoodSelected(long dayId, long mealId, long foodId, string foodType, FoodPlanReserveDTO model)
    {
        if (model.ExistingReserveDetails == null || !model.ExistingReserveDetails.Any())
            return false;

        var detail = model.ExistingReserveDetails.FirstOrDefault(d => d.DayId == dayId && d.MealId == mealId);
        if (detail == null)
            return false;

        switch (foodType)
        {
            case "Main": return detail.MainFoodId == foodId;
            case "Dessert": return detail.DessertId == foodId;
            case "SideDish": return detail.SideDishId == foodId;
            default: return false;
        }
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            function toPersianNumber(value) {
                return String(value).replace(/\d/g, function (digit) {
                    return '۰۱۲۳۴۵۶۷۸۹'[digit];
                });
            }

            function updateSelectionCount() {
                var count = $('input[name^="MainFood_"]:checked').filter(function () {
                    return $(this).val();
                }).length;

                $('#selectionCount').text(toPersianNumber(count));
            }

            $('input[type="radio"]').on('change', updateSelectionCount);
            updateSelectionCount();

            $('.delete-day-btn').on('click', function () {
                var dayId = $(this).data('day-id');
                var dayTitle = $(this).data('day-title');

                // SweetAlert2 (در Layout شما هست)
                swal({
                    title: 'حذف روز',
                    text: 'آیا از حذف برنامه غذایی روز ' + dayTitle + ' اطمینان دارید؟',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'بله، حذف کن',
                    cancelButtonText: 'انصراف',
                    confirmButtonClass: 'btn btn-danger',
                    cancelButtonClass: 'btn btn-default',
                    buttonsStyling: false
                }).then(function () {

                    $.ajax({
                        url: '@Url.Action("DeleteDay", "Reserve")',
                        type: 'POST',
                        data: { dayId: dayId },
                        success: function (response) {
                            if (response.success) {
                                swal({
                                    title: 'انجام شد',
                                    text: 'برنامه غذایی روز حذف شد.',
                                    type: 'success',
                                    confirmButtonText: 'باشه',
                                    confirmButtonClass: 'btn btn-success',
                                    buttonsStyling: false
                                }).then(function () {
                                    location.reload();
                                });
                            } else {
                                swal({
                                    title: 'خطا',
                                    text: response.message || 'خطا در حذف روز',
                                    type: 'error',
                                    confirmButtonText: 'باشه',
                                    confirmButtonClass: 'btn btn-danger',
                                    buttonsStyling: false
                                });
                            }
                        },
                        error: function () {
                            swal({
                                title: 'خطا',
                                text: 'خطا در ارتباط با سرور.',
                                type: 'error',
                                confirmButtonText: 'باشه',
                                confirmButtonClass: 'btn btn-danger',
                                buttonsStyling: false
                            });
                        }
                    });

                }).catch(function () { });
            });
        });
    </script>
}
