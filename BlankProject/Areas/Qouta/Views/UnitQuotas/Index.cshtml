@model IEnumerable<DTO.Entities.UnitQuotaDTO>

@{
    ViewData["Title"] = "نمایش سهمیه‌بندی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var canViewAll = ViewBag.CanViewAllOrganizations == true;
    var currentOrgId = Convert.ToInt32(ViewBag.CurrentOrgId ?? 0);
}

@if (canViewAll)
{
    <div class="col-md-12">
        <div class="card filter">
            <div class="col-md-12">
                <div class="col-md-12 text-center filter-caption">
                    <a class="btn btn-simple btn-icon pull-right slide-filter"
                       onclick="searchFilter.toggle(this)">
                        <i class="material-icons">arrow_drop_down</i>
                    </a>
                    یگان مورد نظر را انتخاب کرده و روی دکمه
                    <b>جستجو</b>
                    کلیک کنید.
                </div>

                <div class="row filter-container">
                    <div class="col-md-12">
                        <div class="col-md-4 form-group">
                            <label class="label-control">یگان:</label>

                            <select id="FilterOrgId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.Organizations">
                                <option value="">همه یگان‌ها</option>
                            </select>
                        </div>

                        <div class="col-md-1 form-group">
                            <a class="btn btn-just-icon btn-success filter-search-btn"
                               title="جستجو"
                               data-toggle="tooltip"
                               onclick="unitQuota.list.reload()">
                                <i class="material-icons">search</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header card-header-icon"
             data-background-color="purple">
            <i class="material-icons">assignment</i>
        </div>

        <div class="card-content">
            <h4 class="card-title">لیست سهمیه‌بندی یگان‌ها</h4>

            <div class="material-datatables">
                <table id="datatables"
                       class="table table-striped table-no-bordered table-hover"
                       cellspacing="0"
                       style="width:100%">
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>یگان</th>
                            <th>نوع سهمیه</th>
                            <th>وعده</th>
                            <th>نوع روز</th>
                            <th>تعداد</th>
                            <th class="disabled-sorting">عملیات</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="base-modal"
     tabindex="-1"
     role="dialog"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog"
         style="width:90%"
         role="document">
        <div class="modal-content" id="modal-form"></div>
    </div>
</div>

<form id="operation-token-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        var unitQuotaPermissions = {
            canViewAllOrganizations: @canViewAll.ToString().ToLower(),
            currentOrgId: @currentOrgId
        };
    </script>

    <script src="~/assets/js/jquery.datatables.js"></script>
    <script src="~/assets/selectize/selectize.min.js"></script>
    <script src="~/Areas/unitQuota/UnitQuota.js"
            asp-append-version="true"></script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css"
          rel="stylesheet" />

    <style>
        .quota-summary {
            background:#f7f7f7;
            border:1px solid #ddd;
            border-radius:4px;
            padding:12px;
            margin-bottom:15px;
        }

        .quota-summary-item {
            margin-bottom:8px;
        }

        .quota-person-table {
            margin-top:20px;
        }

        .quota-person-result {
            min-height:25px;
            margin-top:8px;
        }

        .quota-capacity {
            font-weight:bold;
        }

        .quota-capacity-success {
            color:#4caf50;
        }

        .quota-capacity-danger {
            color:#f44336;
        }

        .quota-modal-notification {
            display:none;
            margin-bottom:15px;
        }

        .operation-button {
            cursor:pointer;
        }

        .quota-excel-import {
            margin-top: 20px;
        }

        .quota-excel-card {
            border: 1px solid #dfe7ef;
            border-radius: 10px;
            background: #fbfcfe;
            padding: 15px;
        }

        .quota-excel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .quota-excel-head strong {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 15px;
            color: #34495e;
        }

        .quota-excel-help {
            margin-top: 5px;
            color: #7b8794;
            font-size: 12px;
        }

        .quota-excel-panel {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px dashed #ccd6e0;
        }

        .quota-excel-step {
            min-height: 150px;
            display: flex;
            gap: 10px;
            padding: 14px;
            background: #fff;
            border: 1px solid #e7edf3;
            border-radius: 9px;
        }

        .quota-excel-step-number {
            width: 30px;
            height: 30px;
            min-width: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #00bcd4;
            color: #fff;
            font-weight: bold;
        }

        .quota-excel-step p {
            margin: 6px 0;
            color: #8a96a3;
            font-size: 11px;
            line-height: 1.8;
        }

        .quota-excel-file-label {
            cursor: pointer;
            margin-top: 5px;
        }

        .quota-excel-file-name {
            margin-top: 7px;
            color: #607d8b;
            font-size: 11px;
            word-break: break-all;
        }

        .quota-excel-loading {
            margin-top: 15px;
            padding: 12px;
            text-align: center;
            border-radius: 7px;
            background: #eef7fb;
            color: #31708f;
        }

        .quota-excel-spin {
            vertical-align: middle;
            animation: quotaExcelSpin 1s linear infinite;
        }

        @@keyframes quotaExcelSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .quota-excel-result {
            margin-top: 15px;
        }

        .quota-excel-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(110px, 1fr));
            gap: 10px;
            margin-bottom: 12px;
        }

        .quota-excel-stat {
            padding: 12px;
            text-align: center;
            background: #fff;
            border: 1px solid #e5e9ed;
            border-radius: 8px;
        }

        .quota-excel-stat strong {
            display: block;
            font-size: 22px;
            color: #455a64;
        }

        .quota-excel-stat span {
            color: #7b8794;
            font-size: 11px;
        }

        .quota-excel-stat-success strong {
            color: #4caf50;
        }

        .quota-excel-stat-warning strong {
            color: #ff9800;
        }

        .quota-excel-stat-danger strong {
            color: #f44336;
        }

        .quota-excel-result-table {
            max-height: 330px;
            overflow: auto;
            background: #fff;
            border: 1px solid #e5e9ed;
            border-radius: 8px;
        }

        .quota-excel-result-table table {
            margin-bottom: 0;
        }

        @@media (max-width: 767px) {
            .quota-excel-head {
                align-items: stretch;
                flex-direction: column;
            }

            .quota-excel-head .btn {
                width: 100%;
            }

            .quota-excel-step {
                min-height: auto;
                margin-bottom: 10px;
            }

            .quota-excel-summary {
                grid-template-columns: repeat(2, minmax(100px, 1fr));
            }
        }
    </style>
}