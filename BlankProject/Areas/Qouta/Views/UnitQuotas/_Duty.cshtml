@model DTO.Entities.UnitQuotaPersonFormDTO
@using DTO.Base

@{
    var diningHalls = ViewBag.DiningHalls as IEnumerable<SelectListDTO>
        ?? new List<SelectListDTO>();
}

<div id="quota-person-modal-data"
     data-type="duty"
     data-unit-quota-id="@Model.UnitQuotaId"
     data-meal-id="@Model.MealId">
</div>

<div class="modal-header">
    <button type="button"
            class="close"
            title="بستن پنجره"
            data-dismiss="modal"
            aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title">ثبت کارکنان وظیفه</h4>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <div class="quota-summary row">
            <div class="col-md-3 quota-summary-item">
                <strong>نوع سهمیه:</strong>
                @Model.YeganTypeTitle
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>وعده:</strong>
                @Model.MealTitle
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>نوع روز:</strong>
                @Model.DayTypeTitle
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>یگان:</strong>
                @Model.OrgTitle
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>تعداد سهمیه:</strong>
                <span id="QuotaCountDisplay"
                      data-quota-count="@Model.QuotaCount">
                    @Model.QuotaCount
                </span>
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>تعداد ثبت‌شده:</strong>
                <span id="RegisteredCountDisplay">
                    @Model.RegisteredCount
                </span>
            </div>

            <div class="col-md-3 quota-summary-item">
                <strong>باقی‌مانده:</strong>
                <span id="RemainingCountDisplay"
                      class="quota-capacity @(Model.RemainingCount > 0 ? "quota-capacity-success" : "quota-capacity-danger")">
                    @Model.RemainingCount
                </span>
            </div>
        </div>

        <div id="QuotaModalNotification"
             class="col-md-12 quota-modal-notification">
        </div>

        <form action="/Qouta/UnitQuotas/CreateDuty"
              method="post"
              class="duty-form"
              onsubmit="return unitQuota.duty.save(event)">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="DutyUnitQuotaId"
                   name="UnitQuotaId"
                   value="@Model.UnitQuotaId" />

            <input type="hidden"
                   id="DutyMealId"
                   name="MealId"
                   value="@Model.MealId" />

            <div class="error text-center text-danger"></div>

            <div class="col-md-12">
                <div class="form-group col-md-3">
                    <label class="control-label text-right col-md-12 required">
                        کد ملی
                    </label>
                    <div class="col-md-12">
                        <input id="DutyNationalCode"
                               name="NationalCode"
                               class="form-control"
                               maxlength="10"
                               autocomplete="off"
                               placeholder="کد ملی 10 رقمی" />
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label class="control-label text-right col-md-12 required">
                        کد پرسنلی
                    </label>
                    <div class="col-md-12">
                        <input id="DutyPersonCode"
                               name="PersonCode"
                               class="form-control"
                               maxlength="20"
                               autocomplete="off" />
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label class="control-label text-right col-md-12 required">
                        نام و نشان
                    </label>
                    <div class="col-md-12">
                        <input id="DutyFullName"
                               name="FullName"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off" />
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label class="control-label text-right col-md-12 required">
                        سالن غذاخوری
                    </label>
                    <div class="col-md-12">
                        <select id="DutyDiningHallId"
                                name="DiningHallId"
                                class="selectpicker"
                                data-live-search="true"
                                data-size="7"
                                data-style="select-with-transition">
                            <option value="">انتخاب کنید</option>
                            @foreach (var hall in diningHalls)
                            {
                                <option value="@hall.Id">@hall.Title</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group col-md-12 text-center">
                <button type="submit"
                        id="DutySaveButton"
                        class="btn btn-info">
                    <i class="material-icons">save</i>
                    ذخیره اطلاعات
                </button>
            </div>
        </form>


        <div class="col-md-12 quota-excel-import">
            <div class="quota-excel-card">
                <div class="quota-excel-head">
                    <div>
                        <strong>
                            <i class="material-icons">description</i>
                            ثبت گروهی کارکنان وظیفه با Excel
                        </strong>
                        <div class="quota-excel-help">
                            برای تعداد زیاد نفرات، فایل نمونه را دریافت کنید،
                            اطلاعات را تکمیل کرده و سپس فایل را بارگذاری نمایید.
                        </div>
                    </div>

                    <button type="button"
                            class="btn btn-success"
                            onclick="unitQuota.excel.toggle('duty')">
                        <i class="material-icons">playlist_add</i>
                        ثبت گروهی با اکسل
                    </button>
                </div>

                <div id="duty-excel-panel"
                     class="quota-excel-panel"
                     style="display:none">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="quota-excel-step">
                                <span class="quota-excel-step-number">1</span>
                                <div>
                                    <strong>فایل نمونه را دانلود کنید</strong>
                                    <p>ساختار فایل را تغییر ندهید.</p>
                                    <a class="btn btn-simple btn-info"
                                       href="/Qouta/UnitQuotas/DownloadExcelTemplate?personnelType=duty">
                                        <i class="material-icons">file_download</i>
                                        دانلود فایل نمونه
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="quota-excel-step">
                                <span class="quota-excel-step-number">2</span>
                                <div style="width:100%">
                                    <strong>سالن و فایل را انتخاب کنید</strong>
                                    <p>
                                        سالن از فیلد «سالن غذاخوری» بالای فرم استفاده می‌شود.
                                    </p>
                                    <label class="btn btn-default btn-block quota-excel-file-label">
                                        <i class="material-icons">attach_file</i>
                                        انتخاب فایل Excel
                                        <input type="file"
                                               id="duty-excel-file"
                                               accept=".xlsx"
                                               style="display:none"
                                               onchange="unitQuota.excel.fileChanged('duty', this)" />
                                    </label>
                                    <div id="duty-excel-file-name"
                                         class="quota-excel-file-name">
                                        فایلی انتخاب نشده است.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="quota-excel-step">
                                <span class="quota-excel-step-number">3</span>
                                <div style="width:100%">
                                    <strong>ثبت گروهی</strong>
                                    <p>رکوردهای معتبر ثبت و خطاها همان‌جا نمایش داده می‌شوند.</p>
                                    <button type="button"
                                            id="duty-excel-submit"
                                            class="btn btn-success btn-block"
                                            onclick="unitQuota.excel.upload('duty')">
                                        <i class="material-icons">cloud_upload</i>
                                        بررسی و ثبت فایل
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="duty-excel-loading"
                         class="quota-excel-loading"
                         style="display:none">
                        <i class="material-icons quota-excel-spin">sync</i>
                        در حال بررسی و ثبت اطلاعات...
                    </div>

                    <div id="duty-excel-result"
                         class="quota-excel-result"
                         style="display:none">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 quota-person-table">
            <h4>کارکنان وظیفه ثبت‌شده</h4>
            <div class="material-datatables">
                <table id="duty-person-datatable"
                       class="table table-striped table-no-bordered table-hover"
                       cellspacing="0"
                       style="width:100%">
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>کد ملی</th>
                            <th>کد پرسنلی</th>
                            <th>نام و نشان</th>
                            <th>سالن غذاخوری</th>
                            <th class="disabled-sorting">عملیات</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>