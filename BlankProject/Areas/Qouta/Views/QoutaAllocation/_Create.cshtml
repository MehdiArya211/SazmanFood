@model DTO.Entities.QoutaAllocationCreateDTO

<div class="modal-header">
    <button type="button" class="close" title="بستن پنجره" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h5 class="modal-title" id="modal5-label">
        افزودن سهمیه جدید
    </h5>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <form asp-action="Create" class="create-form" onsubmit="return qoutaAllocation.create.save(event)">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <hr />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="error text-center text-danger">@ViewBag.Error</div>

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="OrganGarrisonParentId" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <select id="provinceList"
                                    asp-for="OrganGarrisonParentId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.OrganGarrison">
                                <option value="">لطفا پادگان را انتخاب نمایید</option>
                            </select>
                            <span asp-validation-for="OrganGarrisonParentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="OrganGarrisonId" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <select id="cityList"
                                    asp-for="OrganGarrisonId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition">
                                <option value="">لطفا ابتدا پادگان مورد نظر را انتخاب نمایید</option>
                            </select>
                            <span asp-validation-for="OrganGarrisonId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="QoutaAllocationDate" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <div id="VueStartDate1">
                                <date-picker v-model="date"
                                             type="date"
                                             editable="true"
                                             auto-submit="true"
                                             input-class="form-control"
                                             alt-format="YYYY-MM-DD HH:mm:ss"
                                             alt-name="RegQoutaAllocationDate"
                                             @@close="onClose">
                                </date-picker>
                            </div>
                            <span asp-validation-for="QoutaAllocationDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="DayId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="DayId"
                                    asp-for="DayId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="@ViewBag.Days">
                                <option value="">لطفا روز را انتخاب نمایید</option>
                            </select>
                            <span asp-validation-for="DayId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="MealId" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <select id="MealId"
                                    asp-for="MealId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="@ViewBag.Meals">
                                <option value="">لطفا وعده را انتخاب نمایید</option>
                            </select>
                            <span asp-validation-for="MealId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <hr />
                    <h5 class="text-center">ظرفیت و مجوزهای ثبت غذا</h5>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-3">
                        <label asp-for="OfficerCapacity" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <input asp-for="OfficerCapacity" class="form-control" onkeypress="return isNumberKey(event)" />
                            <span asp-validation-for="OfficerCapacity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="SoldierCapacity" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <input asp-for="SoldierCapacity" class="form-control" onkeypress="return isNumberKey(event)" />
                            <span asp-validation-for="SoldierCapacity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="GuestCapacity" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <input asp-for="GuestCapacity" class="form-control" onkeypress="return isNumberKey(event)" />
                            <span asp-validation-for="GuestCapacity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="ManagementTokenCapacity" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <input asp-for="ManagementTokenCapacity" class="form-control" onkeypress="return isNumberKey(event)" />
                            <span asp-validation-for="ManagementTokenCapacity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="RegisterDeadline" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <div id="VueRegisterDeadline">
                                <date-picker v-model="date"
                                             type="datetime"
                                             editable="true"
                                             auto-submit="true"
                                             input-class="form-control"
                                             alt-format="YYYY-MM-DD HH:mm:ss"
                                             alt-name="RegisterDeadline"
                                             @@close="onClose">
                                </date-picker>
                            </div>
                            <span asp-validation-for="RegisterDeadline" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="AllowOfficeUserRegister" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <label class="toggle" style="margin-top:5px">
                                <input asp-for="AllowOfficeUserRegister" type="checkbox" checked />
                                <span class="slider"></span>
                                <span class="labels" data-on="فعال" data-off="غیرفعال"></span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group col-md-3">
                        <label asp-for="AllowPersonChange" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <label class="toggle" style="margin-top:5px">
                                <input asp-for="AllowPersonChange" type="checkbox" />
                                <span class="slider"></span>
                                <span class="labels" data-on="فعال" data-off="غیرفعال"></span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group col-md-2">
                        <label asp-for="IsFinalized" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <label class="toggle" style="margin-top:5px">
                                <input asp-for="IsFinalized" type="checkbox" />
                                <span class="slider"></span>
                                <span class="labels" data-on="نهایی" data-off="باز"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-12 text-center">
                    <div class="btn-group">
                        <button type="submit" class="btn btn-info">
                            <i class="material-icons">send</i>
                            ذخیره اطلاعات
                        </button>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>