@model IEnumerable<DTO.QoutaAllocationDataTableDTO>
@using Services.SessionServices

@{
    ViewData["Title"] = "مدیریت سهمیه بندی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var Admin = Context.Session.GetUser();
}

<style>
    #datatables tbody {
        height: 10px;
        font-size: 12px;
    }

    #datatables td,
    #datatables th {
        padding: 1px 2px;
        vertical-align: middle;
    }

    .filter .form-group {
        margin-bottom: 5px;
    }

    .filter-search-btn {
        margin-top: 24px;
    }

    .quota-card {
        margin-top: -10px;
    }

    .quota-table-wrapper {
        margin-top: -20px;
    }

    #seccond-modal .modal-dialog {
        width: 90%;
    }

    #third-modal .modal-dialog {
        width: 60%;
    }

    .modal .modal-content {
        border-radius: 6px;
    }
</style>

<!-- فیلترها -->
<div class="col-md-12" style="margin-top:-20px">
    <div class="card filter">
        <div class="col-md-12">
            <div class="row filter-container">

                <div class="col-md-12">

                    <div class="col-md-2 form-group">
                        <label class="label-control">پادگان:</label>
                        <div>
                            <select id="FilterOrganGarrisonParentId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true"
                                    asp-items="@ViewBag.OrganGarrison">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">یگان پادگان:</label>
                        <div>
                            <select id="FilterOrganGarrisonId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group col-md-2">
                        <label class="label-control">تاریخ:</label>
                        <div style="display:block">
                            <div id="VueStartDate" style="display:block;">
                                <date-picker v-model="date"
                                             type="date"
                                             editable="true"
                                             auto-submit="true"
                                             input-class="form-control"
                                             alt-format="YYYY-MM-DD HH:mm:ss"
                                             alt-name="FilterStartDate"
                                             @@close="onClose">
                                </date-picker>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">روز هفته:</label>
                        <div>
                            <select id="FilterDayId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true"
                                    asp-items="@ViewBag.Days">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 form-group">
                        <label class="label-control">وعده:</label>
                        <div>
                            <select id="FilterMealId"
                                    class="selectpicker"
                                    data-size="7"
                                    tabindex="-98"
                                    data-style="select-with-transition"
                                    data-live-search="true"
                                    asp-items="@ViewBag.Meals">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-1 col-sm-4 col-xs-6 form-group">
                        <div>
                            <a class="btn btn-just-icon btn-success filter-search-btn"
                               title="جستجو"
                               data-toggle="tooltip"
                               onclick="qoutaAllocation.list.reload()">
                                <i class="material-icons">search</i>
                            </a>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- لیست سهمیه بندی -->
<div class="col-md-12 quota-card">
    <div class="card p-2">
        <div class="card-header card-header-icon p-2" data-background-color="purple">
            <i class="material-icons">assignment</i>
        </div>

        <div class="card-content">
            <h5 class="card-title" style="margin-top:-10px">لیست سهمیه بندی‌ها</h5>

            <div class="toolbar p-1">
                <p>
                    <a onclick="qoutaAllocation.create.loadForm()" class="btn btn-sm btn-success">
                        <i class="material-icons">add_circle_outline</i>
                        افزودن سهمیه جدید
                    </a>
                </p>
            </div>

            <div class="material-datatables quota-table-wrapper">
                <table id="datatables" class="table table-striped table-sm table-hover" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>پادگان</th>
                            <th>یگان پادگان</th>
                            <th>روز</th>
                            <th>تاریخ</th>
                            <th>وعده</th>
                            <th class="disabled-sorting">عملیات</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- چارچوب مدال اصلی -->
<div class="modal fade" id="base-modal" tabindex="-1" role="dialog" aria-labelledby="modal5-label" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="width:75%" role="document">
        <div class="modal-content" id="modal-form">
        </div>
    </div>
</div>

<!-- چارچوب مدال دوم برای نفرات سهمیه -->
<div class="modal fade" id="seccond-modal" tabindex="-1" role="dialog" aria-labelledby="modal5-label" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="seccond-modal-form">
        </div>
    </div>
</div>

<!-- چارچوب مدال سوم برای ثبت مهمان -->
<div class="modal fade" id="third-modal" tabindex="-1" role="dialog" aria-labelledby="modal5-label" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="third-modal-form">
        </div>
    </div>
</div>

<!-- توکن عمومی برای عملیات Ajax مثل حذف -->
<form id="anti-forgery-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/assets/js/jquery.datatables.js"></script>

    <!--For Selectize-->
    <script src="~/assets/selectize/selectize.min.js"></script>

    <!--For DateTimePicker-->
    <script src="~/assets/VuePersianDateTimePicker/vue.min.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/moment/moment.min.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/moment/moment-jalaali.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/dist/vue-persian-datetime-picker-browser.js"></script>

    <script src="~/areas/qouta/qoutaallocation.js" asp-append-version="true"></script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css" rel="stylesheet" />
}