@model DTO.QoutaPersonCreateDTO

<div class="modal-header">
    <button type="button" class="close" title="بستن پنجره" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h5 class="modal-title" id="modal5-label">
        افزودن نفرات سهمیه
    </h5>
</div>

<div class="modal-body row" style="margin-top:-10px">

    <div class="col-md-12">
        <div class="card card-modern shadow-sm mb-1">
            <div class="card-header">
                سهمیه: @Model.MealTitle
            </div>

            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-6 d-flex">
                        <span class="info-title">کادر:</span>
                        <span class="info-text">@Model.EstedadeKadr نفر</span>
                    </div>

                    <div class="col-md-6 d-flex">
                        <span class="info-title">وظیفه:</span>
                        <span class="info-text">@Model.EstedadeVazife نفر</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="CreateAddPerson" class="create-form-RegPortalCode" onsubmit="return qoutaAllocation.createAddPerson.save(event)">
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="error text-center text-danger">@ViewBag.Error</div>

            <input asp-for="QoutaAllocationId" type="hidden" />
        </div>
    </form>

    <div class="col-md-12">
        <div class="row mb-2" style="margin-top:10px">

            <div class="col-md-3">
                <label class="mb-1">نوع ژتون</label>
                <select id="bulkFoodTokenTypeId" class="form-control form-control-sm">
                    <option value="1">عادی</option>
                    <option value="2">مدیریتی</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="mb-1">غذای اصلی برای افراد انتخاب‌شده</label>
                <select id="bulkMainFood" class="form-control form-control-sm" asp-items="@ViewBag.AvailableMainFoods">
                    <option value="">انتخاب غذا</option>
                </select>
            </div>

            <div class="col-md-5" style="display:flex;justify-content:flex-end;align-items:end;margin-top:24px">
                <button type="button" class="btn btn-info btn-sm ml-2" id="btnApplyFoodToSelected">
                    اعمال غذا به انتخاب‌شده‌ها
                </button>

                <button type="button" class="btn btn-success btn-sm" id="btnSaveBulk">
                    ثبت گروهی
                </button>

                <button type="button" class="btn btn-warning btn-sm" onclick="qoutaAllocation.guest.loadForm()">
                    ثبت مهمان
                </button>
            </div>

        </div>
    </div>

    <div class="col-md-12">
        <div class="material-datatables" style="width:100% !important">
            <table id="listPersonCourse" class="table table-striped table-no-bordered table-hover" cellspacing="0" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" id="selectAllPeople" title="انتخاب همه" />
                        </th>
                        <th>نام</th>
                        <th>نشان</th>
                        <th>کد پرسنلی</th>
                        <th>غذای انتخاب‌شده</th>
                        <th>غذای اصلی</th>
                        <th>نوع ژتون</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

<script>
    window.availableMainFoods = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(ViewBag.AvailableMainFoodsJson ?? new List<object>())
    );
</script>