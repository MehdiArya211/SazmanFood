@model Domain.Entities.QoutaPerson

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>چاپ ژتون</title>

    <style>
        body {
            font-family: Tahoma;
            direction: rtl;
            width: 220px;
            margin: 0 auto;
            font-size: 12px;
        }

        .token {
            border: 1px solid #000;
            padding: 8px;
            text-align: center;
        }

        .title {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .row {
            margin: 4px 0;
        }

        @@media print {
            button {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="token">
        <div class="title">ژتون غذا</div>

        <div class="row">نام: @Model.FName @Model.LName</div>
        <div class="row">کد: @Model.PersonalCode</div>
        <div class="row">کد تحویل: @Model.DeliveryCode</div>
        <div class="row">غذا: @Model.MainFood?.Title</div>
        <div class="row">یگان: @Model.OrgTitle</div>

        <hr />

        <div class="row">نوش جان</div>
    </div>

    <br />

    <button onclick="window.print()">چاپ</button>
</body>
</html>