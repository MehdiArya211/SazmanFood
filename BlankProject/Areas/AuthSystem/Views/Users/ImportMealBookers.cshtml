@{
    ViewData["Title"] = "ثبت گروهی کاربران رزرو غذا";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 meal-import-page" dir="rtl">
    <div class="card meal-import-card">
        <div class="card-content">
            <div class="meal-import-head">
                <div>
                    <span class="meal-import-kicker">مدیریت کاربران</span>
                    <h3>ثبت گروهی کاربران رزرو غذا</h3>
                    <p>کد پرسنلی، نام و نام خانوادگی را از اکسل وارد کنید. نتیجهٔ ثبت هر نفر در همین صفحه نمایش داده می‌شود.</p>
                </div>
                <a asp-area="AuthSystem" asp-controller="Users" asp-action="Index" class="btn btn-default">
                    <i class="material-icons">arrow_forward</i> بازگشت به کاربران
                </a>
            </div>

            <div class="meal-import-guide">
                <div><strong>۱</strong><span>فایل نمونه را دریافت و ستون‌ها را تکمیل کنید.</span></div>
                <div><strong>۲</strong><span>کد پرسنلی را در اکسل به‌صورت Text نگه دارید تا صفرهای ابتدایی حفظ شوند.</span></div>
                <div><strong>۳</strong><span>فایل را بارگذاری کنید و نتیجهٔ هر ردیف را بررسی کنید.</span></div>
            </div>

            <div class="meal-import-actions">
                <a asp-area="AuthSystem" asp-controller="Users" asp-action="DownloadMealBookersTemplate"
                   class="btn btn-success"><i class="material-icons">file_download</i> دریافت فایل نمونه</a>
                <span>فرمت فایل: xlsx · حداکثر ۵ مگابایت و ۱۰۰۰ نفر</span>
            </div>

            <form id="mealbooker-import-form"
                  action="@Url.Action("ImportMealBookers", "Users", new { area = "AuthSystem" })"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label class="meal-import-file" for="mealbooker-file">
                    <i class="material-icons" aria-hidden="true">description</i>
                    <span>
                        <strong>فایل اکسل کاربران را انتخاب کنید</strong>
                        <small id="mealbooker-file-name">هنوز فایلی انتخاب نشده است.</small>
                    </span>
                    <span class="btn btn-primary">انتخاب فایل</span>
                </label>
                <input id="mealbooker-file" name="file" type="file" accept=".xlsx"
                       class="meal-import-hidden" required />
                <div class="meal-import-submit">
                    <button id="mealbooker-submit" type="submit" class="btn btn-primary btn-lg">
                        <i class="material-icons">group_add</i> بررسی و ایجاد حساب‌ها
                    </button>
                    <p>نام کاربری و رمز اولیهٔ حساب‌های جدید، کد پرسنلی است. هنگام اولین ورود با رمز، تغییر آن الزامی است. حساب‌های موجود دست‌نخورده می‌مانند.</p>
                </div>
            </form>
            <div id="mealbooker-alert" class="meal-import-alert" role="alert" hidden></div>
        </div>
    </div>

    <section id="mealbooker-results" class="card meal-import-card" hidden aria-live="polite">
        <div class="card-content">
            <div class="meal-import-result-head">
                <div>
                    <h4>نتیجهٔ پردازش فایل</h4>
                    <p>هر ردیف مستقل بررسی شده است؛ خطای یک نفر جلوی ثبت دیگران را نمی‌گیرد.</p>
                </div>
                <button id="mealbooker-download-failures" type="button" class="btn btn-default" hidden>
                    <i class="material-icons">file_download</i> دریافت فهرست ناموفق‌ها
                </button>
            </div>
            <div class="meal-import-stats">
                <div><span>کل ردیف‌ها</span><strong id="mealbooker-total">۰</strong></div>
                <div><span>ایجادشده</span><strong id="mealbooker-created">۰</strong></div>
                <div><span>از قبل موجود</span><strong id="mealbooker-existing">۰</strong></div>
                <div><span>ناموفق</span><strong id="mealbooker-failed">۰</strong></div>
            </div>
            <div class="meal-import-filters" aria-label="فیلتر نتیجه">
                <button type="button" class="active" data-filter="all">همه</button>
                <button type="button" data-filter="failed">ناموفق‌ها</button>
                <button type="button" data-filter="created">ایجادشده‌ها</button>
                <button type="button" data-filter="existing">موجودها</button>
            </div>
            <div class="table-responsive">
                <table class="table table-striped meal-import-table">
                    <thead><tr>
                        <th>ردیف اکسل</th><th>کد پرسنلی</th><th>نام و نام خانوادگی</th>
                        <th>وضعیت</th><th>توضیح</th>
                    </tr></thead>
                    <tbody id="mealbooker-result-rows"></tbody>
                </table>
            </div>
            <p id="mealbooker-empty-filter" class="meal-import-empty" hidden>ردیفی برای این فیلتر وجود ندارد.</p>
        </div>
    </section>
</div>

@section styles {
    <style>
        .meal-import-page { float: none; }
        .meal-import-page [hidden] { display: none !important; }
        .meal-import-card { border-radius: 16px; overflow: hidden; }
        .meal-import-card .card-content { padding: 24px; }
        .meal-import-head, .meal-import-result-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; flex-wrap: wrap; }
        .meal-import-head h3 { margin: 8px 0; font-weight: 800; color: #25344a; }
        .meal-import-head p, .meal-import-result-head p { color: #66758a; line-height: 1.9; }
        .meal-import-kicker { color: #217b59; font-weight: 800; }
        .meal-import-guide { display: flex; gap: 12px; flex-wrap: wrap; margin: 22px 0; }
        .meal-import-guide div { display: flex; align-items: center; gap: 10px; flex: 1 1 220px; padding: 13px; background: #f5f8fb; border: 1px solid #e3eaf0; border-radius: 12px; line-height: 1.8; }
        .meal-import-guide strong { display: grid; place-items: center; min-width: 30px; height: 30px; border-radius: 50%; color: #fff; background: #217b59; }
        .meal-import-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; color: #65758a; }
        .meal-import-file { display: flex; align-items: center; gap: 15px; width: 100%; margin-top: 20px; padding: 22px; border: 2px dashed #b7c9d1; border-radius: 14px; background: #fbfdfd; cursor: pointer; }
        .meal-import-file > .material-icons { font-size: 34px; color: #217b59; }
        .meal-import-file span:nth-child(2) { display: flex; flex-direction: column; gap: 5px; flex: 1; }
        .meal-import-file small { color: #68788a; }
        .meal-import-file .btn { margin: 0; }
        .meal-import-hidden { position: absolute; width: 1px; height: 1px; opacity: 0; }
        .meal-import-hidden:focus + .meal-import-file, .meal-import-file:focus-within { outline: 3px solid #a1d4ba; }
        .meal-import-submit { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
        .meal-import-submit p { flex: 1 1 340px; color: #68788a; line-height: 1.8; }
        .meal-import-alert { margin-top: 17px; padding: 13px 16px; background: #fff1f0; color: #a1262b; border: 1px solid #f4c6c6; border-radius: 10px; }
        .meal-import-result-head h4 { margin: 0; font-weight: 800; }
        .meal-import-stats { display: grid; grid-template-columns: repeat(4, minmax(130px, 1fr)); gap: 12px; margin: 20px 0; }
        .meal-import-stats div { padding: 15px; border-radius: 12px; background: #f5f8fb; display: flex; flex-direction: column; gap: 7px; }
        .meal-import-stats strong { font-size: 23px; color: #25344a; }
        .meal-import-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
        .meal-import-filters button { border: 1px solid #dce5e9; border-radius: 9px; background: white; padding: 8px 14px; }
        .meal-import-filters button.active { background: #217b59; border-color: #217b59; color: white; }
        .meal-import-table th, .meal-import-table td { text-align: right; vertical-align: middle !important; white-space: normal !important; }
        .meal-import-badge { display: inline-block; padding: 5px 10px; border-radius: 18px; font-weight: 700; }
        .meal-import-badge.created { background: #e5f4ec; color: #17683c; }
        .meal-import-badge.existing { background: #eaf1fb; color: #245785; }
        .meal-import-badge.failed { background: #fdeaea; color: #a2222d; }
        .meal-import-empty { text-align: center; padding: 18px; color: #66758a; }
        @@media (max-width: 700px) {
            .meal-import-card .card-content { padding: 16px; }
            .meal-import-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .meal-import-file { flex-wrap: wrap; }
        }
    </style>
}

@section Scripts {
    <script src="~/Areas/AuthSystem/js/importMealBookers.js" asp-append-version="true"></script>
}
