@model IEnumerable<DTO.Menu.MenuSessionDTO>

@if (Model != null)
{
    @foreach (var item in Model)
    {
        if (item.SubMenus == null || item.SubMenus.Count() == 0)
        {
            <partial name="_SingleMenuItem" model="item" />
        }
        else
        {
            <partial name="_MenuWithSubmenu" model="item" />
        }
    }
}
@{
    var rootMenu = ViewData["IsRootMenu"] is bool isRoot && isRoot;
    var hasManagementMenu = Model != null && Model.Any(item =>
        item.Title != null &&
        item.Title.Trim().Contains("امکانات مدیریت") &&
        item.SubMenus != null && item.SubMenus.Any());
}


@if (rootMenu && ViewBag.CanControlQuota == true && !hasManagementMenu)
{
    <li class="nav-item">
        <a data-toggle="collapse" href="#foodQuotaManagementMenu">
            <i class="material-icons">settings</i>
            <p>امکانات مدیریت <b class="caret"></b></p>
        </a>
        <div class="collapse" id="foodQuotaManagementMenu">
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/QuotaControl/Index">
                        <i class="material-icons">tune</i>
                        <p>کنترل سهمیه‌بندی غذا</p>
                    </a>
                </li>
            </ul>
        </div>
    </li>
}
