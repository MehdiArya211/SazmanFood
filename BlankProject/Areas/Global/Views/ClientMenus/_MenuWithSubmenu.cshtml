@model DTO.Menu.MenuSessionDTO


<li class="nav-item">
    <a data-toggle="collapse" href="@("#menu" + Model.Id)">
        <i class="@(Model.Icon == null ? "" : "material-icons")">@(Model.Icon ?? Model.Title.Substring(0,3))</i>
        <p>
            @Model.Title
            <b class="caret"></b>
        </p>
    </a>
    <div class="collapse" id="@("menu" + Model.Id)">
        <ul class="nav">

            @{
                var childViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
                childViewData["IsRootMenu"] = false;
            }
            <partial name="_Menus" model="Model.SubMenus" view-data="childViewData" />
            @if (ViewBag.CanControlQuota == true &&
                Model.Title != null &&
                Model.Title.Trim().Contains("امکانات مدیریت"))
            {
                <li class="nav-item @(ViewBag.Controller == "quotacontrol" ? "active" : "")">
                    <a class="nav-link"
                       href="/Admin/QuotaControl/Index">
                        <i class="material-icons">tune</i>
                        <p>کنترل سهمیه‌بندی غذا</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       href="/Admin/QuotaControl/Index#food-timing-settings">
                        <i class="material-icons">schedule</i>
                        <p>زمان‌بندی رزرو و چاپ ژتون</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/QuotaControl/PrinterDiagnostics">
                        <i class="material-icons">print</i>
                        <p>عیب‌یابی چاپگر سرور</p>
                    </a>
                </li>
            }            

        </ul>
    </div>
</li>
