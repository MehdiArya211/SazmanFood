@model DTO.Entities.QoutaPerson.ChangePersonFoodDTO

<div class="modal-header">
    <button type="button" class="close" title="بستن پنجره" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h4 class="modal-title">
        تغییر غذا
    </h4>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <form asp-action="ChangeFood" class="change-food-form" onsubmit="return myFood.changeFood.save(event)">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <hr />

                <div class="error text-center text-danger">@ViewBag.Error</div>

                <input asp-for="QoutaPersonId" type="hidden" />

                <div class="form-group col-md-4">
                    <label asp-for="MainFoodId" class="control-label text-right col-md-12 required"></label>
                    <div class="col-md-12">
                        <select asp-for="MainFoodId" class="selectpicker" data-live-search="true" asp-items="ViewBag.Foods">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="MainFoodId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label asp-for="DessertId" class="control-label text-right col-md-12"></label>
                    <div class="col-md-12">
                        <select asp-for="DessertId" class="selectpicker" data-live-search="true" asp-items="ViewBag.Desserts">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="DessertId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-4">
                    <label asp-for="SideDishId" class="control-label text-right col-md-12"></label>
                    <div class="col-md-12">
                        <select asp-for="SideDishId" class="selectpicker" data-live-search="true" asp-items="ViewBag.SideDishes">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="SideDishId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-12 text-center">
                    <button type="submit" class="btn btn-info">
                        ذخیره تغییرات
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>