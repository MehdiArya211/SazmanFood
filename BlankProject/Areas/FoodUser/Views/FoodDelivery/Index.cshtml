@model DTO.Entities.QoutaPerson.DeliverFoodByCodeDTO

@{
    ViewData["Title"] = "تحویل غذا";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header card-header-icon" data-background-color="purple">
            <i class="material-icons">qr_code_scanner</i>
        </div>

        <div class="card-content">
            <h4 class="card-title">تحویل غذا با کد ژتون / QR</h4>

            <div class="col-md-12">
                <form asp-action="DeliverByCode" class="delivery-form" onsubmit="return foodDelivery.deliver.save(event)">
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <hr />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="error text-center text-danger"></div>

                        <div class="col-md-12">
                            <div class="form-group col-md-4">
                                <label asp-for="MealId" class="control-label text-right col-md-12 required"></label>
                                <div class="col-md-12">
                                    <select asp-for="MealId"
                                            id="MealId"
                                            class="selectpicker"
                                            data-live-search="true"
                                            data-size="7"
                                            tabindex="-98"
                                            data-style="select-with-transition"
                                            asp-items="ViewBag.Meals">
                                        <option value="">انتخاب وعده</option>
                                    </select>
                                    <span asp-validation-for="MealId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group col-md-5">
                                <label asp-for="DeliveryCode" class="control-label text-right col-md-12 required"></label>
                                <div class="col-md-12">
                                    <input asp-for="DeliveryCode"
                                           id="DeliveryCode"
                                           class="form-control text-center"
                                           autocomplete="off"
                                           autofocus
                                           placeholder="کد ژتون یا QR را وارد / اسکن کنید" />
                                    <span asp-validation-for="DeliveryCode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group col-md-3 text-center" style="margin-top:25px">
                                <button type="submit" class="btn btn-success">
                                    <i class="material-icons">check_circle</i>
                                    تحویل غذا
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div id="delivery-result" class="col-md-12" style="display:none;margin-top:20px">
                <div class="alert alert-success text-center">
                    <h4 style="margin-top:0">
                        <i class="material-icons">done_all</i>
                        غذا با موفقیت تحویل شد
                    </h4>

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <strong>دریافت‌کننده:</strong>
                            <div id="delivery-person">-</div>
                        </div>

                        <div class="col-md-4">
                            <strong>غذا:</strong>
                            <div id="delivery-food">-</div>
                        </div>

                        <div class="col-md-4">
                            <strong>نوع ژتون:</strong>
                            <div id="delivery-token">-</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/areas/fooddelivery/fooddelivery.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            $('.selectpicker').selectpicker('refresh');

            if ($.material) {
                $.material.init();
            }

            setTimeout(function () {
                $('#DeliveryCode').focus();
            }, 300);
        });
    </script>
}

@section styles {
    <style>
        #delivery-result .alert {
            border-radius: 6px;
            padding: 20px;
        }

        #DeliveryCode {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 1px;
        }
    </style>
}