@model IEnumerable<DTO.Entities.FoodPlanDataTableDTO>
@using Services.SessionServices

@{
    ViewData["Title"] = "برنامه غذایی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var Admin = Context.Session.GetUser();
}

<div class="col-md-12">
    <div class="card">
        <div class="card-header card-header-icon" data-background-color="purple">
            <i class="material-icons">assignment</i>
        </div>

        <div class="card-content">
            <h4 class="card-title">لیست برنامه غذایی</h4>

            <div class="toolbar">
                <p>
                    <a onclick="foodPlan.create.loadForm()" class="btn btn-sm btn-success">
                        <i class="material-icons">add_circle_outline</i>
                        افزودن برنامه غذایی جدید
                    </a>
                </p>
            </div>

            <div class="material-datatables">
                <table id="datatables" class="table table-striped table-no-bordered table-hover" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>@Html.DisplayNameFor(model => model.YearsTitle)</th>
                            <th>@Html.DisplayNameFor(model => model.SeasonTitle)</th>
                            <th>@Html.DisplayNameFor(model => model.OrganTitle)</th>
                            <th class="disabled-sorting"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- چارچوب مدال برای فرم ها -->
<div class="modal fade" id="base-modal" tabindex="-1" role="dialog" aria-labelledby="modal5-label" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="width: 74%;" role="document">
        <div class="modal-content" id="modal-form">
        </div>
    </div>
</div>

<!-- توکن عمومی برای عملیات Ajax مثل حذف -->
<form id="anti-forgery-form">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/assets/js/jquery.datatables.js"></script>

    <script src="~/assets/selectize/selectize.min.js"></script>

    <script src="~/assets/VuePersianDateTimePicker/vue.min.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/moment/moment.min.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/moment/moment-jalaali.js"></script>
    <script src="~/assets/VuePersianDateTimePicker/dist/vue-persian-datetime-picker-browser.js"></script>

    <script src="~/Areas/FoodPlan/FoodPlan.js" asp-append-version="true"></script>
}

@section styles {
    <link href="~/assets/selectize/selectize.bootstrap3.css" rel="stylesheet" />

    <style>
        .parameters-section .delete {
            transform: translateY(15px);
        }

            .parameters-section .delete i {
                font-size: 24px;
            }
    </style>
}