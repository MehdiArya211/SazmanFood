@model DTO.Entities.FoodPlanDayDataTableDTO

<div class="modal-header">
    <button type="button" class="close" onclick="foodPlan.list.reload()" title="بستن پنجره" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h4 class="modal-title" id="modal5-label">
        افزودن / ویرایش وعده غذایی
    </h4>

    <div class="text-center">
        پرکردن فیلدهای ستاره دار الزامی است.
    </div>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <form asp-action="CreateAddFood" class="food-plan-day-form" onsubmit="return foodPlan.foodPlanDay.save(event)">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <hr />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="error text-center text-danger">@ViewBag.Error</div>

                <input value="@ViewBag.FoodPlanId" asp-for="FoodPlanId" id="FoodPlanId" type="hidden" />
                <input value="@(ViewBag.FoodPlanDayId ?? 0)" asp-for="FoodPlanDayId" id="FoodPlanDayId" type="hidden" />

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="DayId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="DayId" asp-for="DayId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Days">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="DayId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="MealId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="MealId" asp-for="MealId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Meals">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="MealId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="FoodId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="FoodId" asp-for="FoodId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Foods">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="FoodId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="FoodDesserId" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <select id="FoodDesserId" asp-for="FoodDesserId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.FoodDesser">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="FoodDesserId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="FoodDorchinId" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <select id="FoodDorchinId" asp-for="FoodDorchinId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.FoodDorchin">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="FoodDorchinId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="Count" class="control-label text-right col-md-12"></label>
                        <div class="col-md-12">
                            <input asp-for="Count" class="form-control" onkeypress="return isNumberKey(event)" />
                            <span asp-validation-for="Count" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-12 text-center">
                        <button type="submit" class="btn btn-success">
                            @if ((ViewBag.FoodPlanDayId ?? 0) != 0)
                            {
                                <i class="material-icons">save</i>
                                <span>ویرایش</span>
                            }
                            else
                            {
                                <i class="material-icons">add</i>
                                <span>افزودن</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="material-datatables">
    <table id="AddFoodDaydatatables" class="table table-striped table-no-bordered table-hover" cellspacing="0" style="width:100%">
        <thead>
            <tr>
                <th>شناسه</th>
                <th>@Html.DisplayNameFor(model => model.DayName)</th>
                <th>@Html.DisplayNameFor(model => model.MealName)</th>
                <th>@Html.DisplayNameFor(model => model.FoodTitle)</th>
                <th>@Html.DisplayNameFor(model => model.FoodDesserTitle)</th>
                <th>@Html.DisplayNameFor(model => model.Count)</th>
                <th class="disabled-sorting"></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>