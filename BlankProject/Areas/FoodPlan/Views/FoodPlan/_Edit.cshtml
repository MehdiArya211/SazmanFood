@model DTO.Entities.EditFoodPlanDTO

<div class="modal-header">
    <button type="button" class="close" title="بستن پنجره" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h4 class="modal-title" id="modal5-label">
        ویرایش برنامه غذایی
    </h4>

    <div class="text-center">
        پرکردن فیلدهای ستاره دار الزامی است.
    </div>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <form asp-action="Edit" class="edit-form" onsubmit="return foodPlan.edit.save(event)">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <hr />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="error text-center text-danger">@ViewBag.Error</div>

                <input asp-for="Id" type="hidden" />

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="YearsId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="YearsId" asp-for="YearsId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Years">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="YearsId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="SeasonId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="SeasonId" asp-for="SeasonId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Season">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="SeasonId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="OrganId" class="control-label text-right col-md-12 required"></label>
                        <div class="col-md-12">
                            <select id="OrganId" asp-for="OrganId" class="selectpicker" data-live-search="true" data-size="7"
                                    data-style="select-with-transition" asp-items="ViewBag.Organ">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="OrganId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-3">
                        <label asp-for="IsActive" class="control-label text-right col-md-12"></label>
                        <label asp-for="IsActive" class="toggle for-isEnabled" style="margin-top:5px">
                            <input asp-for="IsActive" type="checkbox" />
                            <span class="slider"></span>
                            <span class="labels" data-on="فعال" data-off="غیر فعال"></span>
                        </label>
                    </div>
                </div>

                <div class="form-group col-md-12 text-center">
                    <div class="btn-group">
                        <button type="submit" class="btn btn-info">
                            <i class="material-icons">save</i>
                            ذخیره اطلاعات
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>