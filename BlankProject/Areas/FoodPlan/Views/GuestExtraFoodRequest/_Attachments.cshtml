@model IEnumerable<DTO.Entities.GuestExtraFoodRequestAttachmentDTO>

@{
    var requestId = Convert.ToInt64(ViewBag.RequestId);
    var canManageAttachments =
        ViewBag.CanManageAttachments == true;
}

<div class="modal-header">
    <button type="button"
            class="close"
            title="بستن پنجره"
            data-dismiss="modal"
            aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h4 class="modal-title">
        الصاقات درخواست
    </h4>

    <div class="text-center">
        فرمت‌های مجاز: pdf, jpg, jpeg, png, doc, docx - حداکثر حجم 5 مگابایت
    </div>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        @if (canManageAttachments)
        {
        <form class="attachment-form"
              enctype="multipart/form-data"
              onsubmit="return guestExtraFoodRequest.attachment.save(event)">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="AttachmentRequestId"
                   name="requestId"
                   value="@requestId" />

            <div class="error text-center text-danger"></div>

            <div class="col-md-12">
                <div class="form-group col-md-5">
                    <label class="control-label text-right col-md-12 required">
                        فایل
                    </label>
                    <div class="col-md-12">
                        <input type="file"
                               id="AttachmentFile"
                               name="file"
                               class="form-control" />
                    </div>
                </div>

                <div class="form-group col-md-5">
                    <label class="control-label text-right col-md-12">
                        توضیحات
                    </label>
                    <div class="col-md-12">
                        <input type="text"
                               id="AttachmentDescription"
                               name="description"
                               class="form-control"
                               maxlength="500" />
                    </div>
                </div>

                <div class="form-group col-md-2">
                    <button type="submit"
                            class="btn btn-info"
                            style="margin-top:25px">
                        <i class="material-icons">save</i>
                        ذخیره
                    </button>
                </div>
            </div>
        </form>
        }
        else
        {
            <div class="alert alert-info">
                پیوست‌های درخواست در این وضعیت فقط قابل مشاهده و دانلود هستند.
            </div>
        }

        <div class="col-md-12 attachment-list">
            <table class="table table-striped table-no-bordered table-hover">
                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>نام فایل</th>
                        <th>حجم</th>
                        <th>توضیحات</th>
                        <th>ثبت‌کننده</th>
                        <th>تاریخ ثبت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var row = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.OriginalFileName</td>
                            <td>@item.FileSizeTitle</td>
                            <td>@item.Description</td>
                            <td>@item.UploaderFullName</td>
                            <td>@item.UploadDateFa</td>
                            <td>
                                <a href="/FoodPlan/GuestExtraFoodRequest/DownloadAttachment/@item.Id"
                                   class="btn btn-simple btn-info btn-icon"
                                   title="دانلود"
                                   data-toggle="tooltip">
                                    <i class="material-icons">file_download</i>
                                </a>

                                @if (item.CanDelete)
                                {
                                    <a onclick="guestExtraFoodRequest.attachment.delete(@item.Id)"
                                       class="btn btn-simple btn-danger btn-icon operation-button"
                                       title="حذف"
                                       data-toggle="tooltip">
                                        <i class="material-icons">close</i>
                                    </a>
                                }
                            </td>
                        </tr>

                        row++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>