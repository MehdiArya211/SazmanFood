@model DTO.Entities.GuestExtraFoodRequestCreateDTO

<div class="modal-header">
    <button type="button"
            class="close"
            title="بستن پنجره"
            data-dismiss="modal"
            aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>

    <h4 class="modal-title">
        ثبت درخواست غذای مهمان / مازاد بر سهمیه
    </h4>

    <div class="text-center">
        پرکردن فیلدهای ستاره‌دار الزامی است.
    </div>
</div>

<div class="modal-body row">
    <div class="col-md-12">
        <form asp-action="Create"
              class="create-form"
              onsubmit="return guestExtraFoodRequest.create.save(event)">
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <hr />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="error text-center text-danger"></div>

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="OrgId"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <select asp-for="OrgId"
                                    class="selectpicker"
                                    data-live-search="true"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.Organizations">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="OrgId"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="MealId"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <select asp-for="MealId"
                                    class="selectpicker"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.Meals">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="MealId"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="PersonalTypeId"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <select asp-for="PersonalTypeId"
                                    class="selectpicker"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.PersonalTypes">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="PersonalTypeId"
                                  class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-4">
                        <label asp-for="YeganTypeId"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <select asp-for="YeganTypeId"
                                    class="selectpicker"
                                    data-size="7"
                                    data-style="select-with-transition"
                                    asp-items="ViewBag.YeganTypes">
                                <option value="">انتخاب کنید</option>
                            </select>
                            <span asp-validation-for="YeganTypeId"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="FromDate"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <div id="VueFromDate">
                                <date-picker v-model="date"
                                             type="date"
                                             editable="true"
                                             auto-submit="true"
                                             input-class="form-control"
                                             alt-format="YYYY-MM-DD HH:mm:ss"
                                             alt-name="FromDate"
                                             @@close="onClose">
                                </date-picker>
                            </div>
                            <span asp-validation-for="FromDate"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="ToDate"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <div id="VueToDate">
                                <date-picker v-model="date"
                                             type="date"
                                             editable="true"
                                             auto-submit="true"
                                             input-class="form-control"
                                             alt-format="YYYY-MM-DD HH:mm:ss"
                                             alt-name="ToDate"
                                             @@close="onClose">
                                </date-picker>
                            </div>
                            <span asp-validation-for="ToDate"
                                  class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group col-md-6">
                        <label asp-for="GuestCount"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <input asp-for="GuestCount"
                                   class="form-control"
                                   type="number"
                                   min="0" />
                            <span asp-validation-for="GuestCount"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="ExtraQuotaCount"
                               class="control-label text-right col-md-12 required">
                        </label>
                        <div class="col-md-12">
                            <input asp-for="ExtraQuotaCount"
                                   class="form-control"
                                   type="number"
                                   min="0" />
                            <span asp-validation-for="ExtraQuotaCount"
                                  class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-12 text-center">
                    <button type="submit" class="btn btn-info">
                        <i class="material-icons">save</i>
                        ذخیره اطلاعات
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>